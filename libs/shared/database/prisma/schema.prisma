generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  SALES
  PURCHASES
  INVENTORY
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EmailSenderMode {
  SHARED
  CUSTOM_DOMAIN
}

enum ReminderTone {
  FRIENDLY
  NEUTRAL
  FIRM
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum UnitOfMeasure {
  KG
  LTR
  MM
  M2
  UNIT
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN
  ADJUSTMENT
  PRODUCTION_IN
  PRODUCTION_OUT
  // Outbound - stock leaving because it's going back to the supplier (e.g.
  // defective units). Opposite direction of RETURN, which is inbound
  // (restocking after a customer credit note) - kept as a separate value
  // instead of reusing RETURN so computeStockDelta's sign isn't ambiguous.
  SUPPLIER_RETURN
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

// AFIP comprobante letter. Applies to both Invoice and CreditNote - the
// model itself (Invoice vs CreditNote) already says which kind of document
// it is, so this only needs to carry the letter, not "CREDIT_NOTE_A" etc.
enum DocumentLetter {
  A
  B
  C
  M
}

// AFIP Concepto (FECAESolicitar): 1=Productos, 2=Servicios,
// 3=Productos y Servicios - mapeado a esos números sólo dentro de
// afip-wsfe-client.ts, igual que DocumentLetter se mapea a CbteTipo ahí
// mismo. PRODUCTOS_Y_SERVICIOS aplica cuando una factura mezcla líneas de
// artículos con isService=true y con isService=false.
enum InvoiceConcept {
  PRODUCTOS
  SERVICIOS
  PRODUCTOS_Y_SERVICIOS
}

// Cómo entra el netAmount de una InvoiceLine al pedido de AFIP - ver
// InvoiceLine.taxKind y TaxCalculationType.EXENTO/NO_GRAVADO.
enum TaxLineKind {
  GRAVADO
  EXENTO
  NO_GRAVADO
}

// Jurisdicción del tributo para AFIP FECAESolicitar (WSFE Tributos[].Id,
// tabla pública de FEParamGetTiposTributos) - eje distinto de
// WithholdingTaxType (que es Ganancias/IVA/IIBB sin importar jurisdicción).
// PROVINCIAL es la opción más común en la práctica (Percepción IIBB).
enum InvoiceTaxLineKind {
  NATIONAL // AFIP Tributo Id 1
  PROVINCIAL // AFIP Tributo Id 2 - Percepción IIBB
  MUNICIPAL // AFIP Tributo Id 3
  INTERNAL // AFIP Tributo Id 4
  OTHER // AFIP Tributo Id 99
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

enum TaxCalculationType {
  PERCENTAGE
  FIXED_AMOUNT
  FORMULA
  // Sin tasa/monto: la línea no lleva IVA discriminado en absoluto. Distinto
  // de PERCENTAGE con rate=0 (que sí es "gravado al 0%", AFIP lo reporta
  // igual dentro de Iva[] con alícuota 3) - EXENTO/NO_GRAVADO se reportan
  // por fuera del breakdown de IVA, en ImpOpEx/ImpTotConc respectivamente
  // (ver InvoiceLine.taxKind y AfipWsfeClient). La diferencia entre las dos
  // es fiscal, no técnica para esta app: EXENTO son operaciones exentas de
  // IVA por norma (ej. ciertos alimentos, libros); NO_GRAVADO son
  // operaciones fuera del objeto del impuesto (ni gravadas ni exentas). El
  // usuario elige la que corresponda según el artículo, esta app no evalúa
  // cuál aplica.
  EXENTO
  NO_GRAVADO
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalLineDirection {
  DEBIT
  CREDIT
}

enum FinancialAccountProvider {
  BANK
  MERCADOPAGO
  PAYPAL
  CASH
}

// ACTIVE/SUSPENDED es un eje administrativo separado de
// TenantSubscription.status (ciclo de facturación) - un tenant puede estar
// ACTIVE en su suscripción y de todos modos SUSPENDED a mano por el
// SuperAdmin (abuso, mora escalada, etc.). Sólo se revisa en el login
// (AuthService.login) - un JWT ya emitido es una foto fija, mismo criterio
// ya aceptado para mustChangePassword/role (ver MustChangePasswordGuard).
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  taxId     String?
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  settings     TenantSettings?
  subscription TenantSubscription?

  @@map("tenants")
}

// El estudio contable que invita/solicita, o al que se invita, no es un
// User individual - es el Tenant entero (varios contadores del mismo
// estudio comparten la misma cartera de clientes, decisión con el usuario).
// No user↔tenant, sino tenant↔tenant.
enum MembershipDirection {
  CLIENT_INVITED
  ACCOUNTANT_REQUESTED
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// Relación tenant↔tenant entre un tenant CLIENTE (tenantId, dueño de la
// fila - RLS estándar) y un tenant ESTUDIO CONTABLE (homeTenantId). Ninguno
// de los dos es una FK real: homeTenantId vive en otro tenant (no se puede
// referenciar cross-tenant, ver PROGRESS.md sobre la fuga de FK simple ya
// corregida) y ambos IDs se resuelven siempre vía las funciones SECURITY
// DEFINER (list_studio_memberships, mismo patrón que list_tenant_ids()/
// find_tenants_by_email en tenant-context/auth), nunca vía RLS directa
// desde el lado del estudio - ver plan en docs/plan_modulo_contadores.txt.
model TenantMembership {
  id                String              @id @default(uuid())
  tenantId          String
  homeTenantId      String
  // Email o CUIT del tenant/estudio invitado, hasta que la invitación se
  // resuelve - mismo criterio que TeamInvitation.email (el invitado
  // todavía no tiene ninguna fila propia acá).
  inviteeIdentifier String?
  direction         MembershipDirection
  status            MembershipStatus    @default(PENDING)
  // Quien disparó la fila - siempre alguien que en ese momento tenía
  // contexto propio (el cliente en CLIENT_INVITED; en ACCOUNTANT_REQUESTED
  // es del lado del estudio, por eso sin @relation, igual criterio que el
  // resto de los *ByUserId de este schema que aún no son FK compuesta).
  initiatedByUserId String
  respondedAt       DateTime?
  createdAt         DateTime            @default(now())

  links       TenantMembershipLink[]
  assignments TenantMembershipAssignment[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([homeTenantId])
  @@map("tenant_memberships")
}

// Identidad de auditoría POR PERSONA, no por estudio - deliberado (ver
// plan): si varios contadores del mismo estudio compartieran una sola fila
// "espejo", sus acciones serían indistinguibles entre sí en el tenant
// cliente, el mismo problema que ya tiene la impersonación. Se crea de
// forma perezosa, la primera vez que ESE usuario puntual del estudio activa
// una sesión en ESE cliente puntual (ver endpoint de activación) - no al
// aceptar la membership, que es a nivel estudio.
model TenantMembershipLink {
  id           String           @id @default(uuid())
  tenantId     String
  membershipId String
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id])
  // User.id del contador puntual, en SU tenant (el estudio) - cross-tenant
  // respecto a tenantId de esta fila, por eso sin @relation (mismo
  // criterio que homeTenantId arriba).
  studioUserId String
  // User.id "espejo" de ese contador puntual, DENTRO de este mismo tenant
  // (el cliente) - FK simple a propósito, no compuesta: a diferencia de los
  // ~22 casos ya endurecidos, este valor nunca sale de un body/request de
  // usuario, lo arma siempre el propio backend dentro de
  // withTenantContext(tenantId cliente) en el mismo momento que crea la
  // fila User referenciada - no hay superficie de ataque que una FK
  // compuesta esté evitando acá.
  linkedUserId String
  linkedUser   User             @relation("MembershipLinkedUser", fields: [linkedUserId], references: [id])
  createdAt    DateTime         @default(now())

  @@unique([membershipId, studioUserId])
  @@index([tenantId])
  @@map("tenant_membership_links")
}

// Reparto de cartera dentro del estudio (ver docs/plan_modulo_contadores.txt,
// Fase 2 punto 4) - conjunto vacío (sin filas para una membership) =
// visible para cualquier OWNER/ADMIN/ACCOUNTANT del estudio (comportamiento
// original, sin cambios); con filas = sólo esos contadores puntuales
// (OWNER/ADMIN del estudio siempre retienen visión completa, filtrado en
// MembershipsService, no acá). Un cliente puede asignarse a varios
// contadores a la vez (N-a-N), decisión confirmada con el usuario.
model TenantMembershipAssignment {
  id           String           @id @default(uuid())
  tenantId     String
  membershipId String
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id])
  // User.id del contador puntual, en SU tenant (el estudio) - cross-tenant,
  // sin @relation, mismo criterio que TenantMembershipLink.studioUserId.
  studioUserId String
  createdAt    DateTime         @default(now())

  @@unique([tenantId, membershipId, studioUserId])
  @@index([tenantId, membershipId])
  @@map("tenant_membership_assignments")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

// Catálogo global de planes comerciales - a diferencia de CUALQUIER otra
// tabla de este schema, no tiene tenantId ni RLS: todos los tenants leen el
// mismo catálogo (ver el bloque RLS de la migración, que deliberadamente NO
// incluye esta tabla). isActive=false retira un plan de la venta sin
// borrarlo - una TenantSubscription vieja puede seguir apuntando a él.
model Plan {
  id                   String   @id @default(uuid())
  key                  String   @unique
  name                 String
  sortOrder            Int      @default(0)
  priceMonthly         Decimal  @db.Decimal(14, 2)
  maxUsers             Int
  maxClients           Int
  maxMonthlyInvoices   Int
  // % de descuento automático cuando TenantSubscription.paymentMethod indica
  // débito - ver SubscriptionService. Editable por el SuperAdmin sin tocar
  // código, igual que el resto de los campos de este modelo.
  debitDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@map("plans")
}

// Fila única (id fijo "global", ver ExchangeRateSchedulerService) - mismo
// criterio que Plan: sin tenantId, sin RLS, editable sólo por el SuperAdmin
// (PlatformAdminGuard). El cron de sincronización con Banco Nación corre
// una sola vez para toda la plataforma (no es por tenant, ver
// ExchangeRateSchedulerService), así que su on/off y horario viven acá, no
// en TenantSettings.
model PlatformSettings {
  id             String   @id @default("global")
  bnaSyncEnabled Boolean  @default(true)
  bnaSyncHour    Int      @default(9)
  // Sync diario de "Índices de Inflación" (IPC) - mismo criterio que
  // bnaSync* de arriba, ver PriceIndexScheduler.
  ipcSyncEnabled Boolean  @default(true)
  ipcSyncHour    Int      @default(10)
  // Duración del token de sesión al activar una membership de estudio
  // contable (ver TenantMembership/POST /memberships/:id/activate) -
  // elegible por el SuperAdmin entre 1/2/5/8hs, igual criterio que
  // bnaSyncHour/ipcSyncHour arriba. Sin revocación activa (mismo límite que
  // ya tiene la impersonación), por eso queda acotado y configurable en vez
  // de fijo.
  membershipSessionDurationHours Int @default(2)
  updatedAt      DateTime @updatedAt

  @@map("platform_settings")
}

enum PriceIndexSource {
  API_ARGENTINADATOS
  MANUAL
}

// Global, SIN tenantId/RLS - mismo criterio que PlatformSettings arriba: el
// IPC es un único dato nacional, igual para todos los tenants (a diferencia
// de ExchangeRateHistory, que sí es tenant-scoped porque Currency lo es).
// Usado por InflationAdjustmentService (RT6/NC39) para reexpresar saldos
// monetarios. monthlyVariationPct es el dato crudo (cargado a mano o
// sincronizado); indexValue es un nivel encadenado, calculado - nunca se
// escribe directo, ver PriceIndexService.recomputeChainFrom.
model PriceIndexEntry {
  id                  String            @id @default(uuid())
  period              DateTime          // primer día del mes, ej 2026-08-01
  monthlyVariationPct Decimal           @db.Decimal(8, 4)
  indexValue          Decimal           @db.Decimal(30, 6)
  source              PriceIndexSource
  updatedByUserId     String?
  updatedAt           DateTime          @updatedAt

  @@unique([period])
  @@map("price_index_entries")
}

// Una por tenant (mismo patrón 1:1 que TenantSettings) - a diferencia de
// Plan, SÍ es tenant-scoped y SÍ tiene RLS (ver la migración). "promo*" son
// 3 campos libres que el SuperAdmin carga a mano por tenant vía
// /api/admin - deliberadamente no un catálogo de cupones reutilizables con
// canjes, eso no fue pedido.
model TenantSubscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  // Informativo únicamente - no hay pasarela de cobro real integrada
  // todavía, nada dispara esta fecha automáticamente.
  currentPeriodEnd     DateTime?
  paymentMethod        String?
  promoLabel           String?
  promoDiscountPercent Decimal?           @db.Decimal(5, 2)
  promoExpiresAt       DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("tenant_subscriptions")
}

// Global como Plan - sin tenantId, sin RLS (ver la migración). Muchos 500
// pasan ANTES de que exista contexto de tenant (ej. un JWT roto), así que
// esta tabla no puede depender de uno - GlobalExceptionFilter escribe acá
// con PrismaService crudo, nunca getTenantDb(). tenantId/userId son
// informativos, sin FK (el request que falló puede no tener ninguno de
// los dos resuelto todavía).
model SystemErrorLog {
  id         String   @id @default(uuid())
  statusCode Int
  message    String
  stack      String?
  path       String
  method     String
  tenantId   String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("system_error_log")
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
}

// Global como Plan. Una fila por corrida de BackupSchedulerService (éxito
// o falla, ver ese archivo para por qué la mayoría de las filas hoy van a
// quedar FAILED con "no configurado" hasta que se instale pg_dump y se
// setee BACKUP_STORAGE_DIR). La rotación FIFO borra filas COMPLETED más
// allá de las últimas 5 - "los últimos 5 puntos de restauración" son,
// literalmente, las filas que sobreviven en esta tabla.
model DatabaseBackup {
  id           String       @id @default(uuid())
  status       BackupStatus @default(PENDING)
  filePath     String?
  sizeBytes    BigInt?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?

  @@map("database_backups")
}

// "homologacion" (sandbox de AFIP) vs "producción" - controla qué WSDL/URL
// de AFIP usa el tenant (ver afip-wsaa-client.ts). Antes era una única
// variable de entorno de proceso (AFIP_ENV); ahora es por tenant, igual que
// el certificado/clave de abajo.
enum AfipEnvironment {
  HOMOLOGACION
  PRODUCCION
}

// Sólo las 3 condiciones que cambian qué letra de comprobante puede emitir
// el propio tenant (ver TenantSettings.ownTaxCondition) - no el universo
// completo de categorías AFIP (eso es Company.taxCondition, texto libre).
enum TenantTaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

// Tenant-wide business-policy toggles, as opposed to User (per-person
// preferences like theme/density, which live in the frontend's localStorage
// today, not the DB) - this is the first one, deliberately its own table
// rather than more columns bolted onto Tenant, since "esta seguramente no
// sería la única" (more of these are expected). One row per tenant, created
// lazily on first PATCH /tenant-settings - reading before that returns
// defaults (see TenantSettingsService).
model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // null = the original one-time alert only (an invoice gets emailed once,
  // the moment it crosses into OVERDUE - see
  // ReceivablesService.listInvoicesBecomingOverdue). A positive number
  // re-sends the same alert every N days while it's still unpaid, via
  // ReceivablesService.sendRecurringReminders.
  arReminderIntervalDays Int?

  // Remitente de emails a clientes (factura emitida + recordatorio de
  // cobranza): SHARED usa el EMAIL_FROM global de siempre; CUSTOM_DOMAIN
  // arma "emailFromName <emailFromLocalPart@emailCustomDomain>" pero sólo
  // una vez que domainStatus === 'verified' (ver resolveEmailFrom en
  // @plexo/tenant-settings) - si no, cae al remitente compartido sin fallar
  // el envío.
  emailSenderMode    EmailSenderMode @default(SHARED)
  emailFromName      String?
  emailFromLocalPart String?
  emailCustomDomain  String?
  resendDomainId     String?
  // Espejo del DomainStatus de Resend ('pending'|'verified'|'failed'|...) -
  // String plano a propósito, es vocabulario de una API externa que no
  // controlamos.
  domainStatus       String?

  // Sólo afecta el recordatorio de cobranza, no el email de factura
  // emitida. NEUTRAL por defecto ≈ el texto que ya se mandaba antes de este
  // campo existir, así un tenant que nunca toca esto no nota cambio.
  reminderTone ReminderTone @default(NEUTRAL)

  // Copia (CC) del recordatorio de cobranza a un buzón interno del tenant
  // (ej. cobranzas@empresa.com) - funciona con el mismo remitente
  // compartido de siempre, sin depender de verificar un dominio propio
  // (eso requiere un plan/API key de Resend con permiso de dominios, que
  // hoy no está disponible). null = no mandar copia a nadie.
  reminderCcEmail String?

  // El tenant es agente de retención de Ganancias/IVA/IIBB ante
  // AFIP/ARBA/etc. - eso lo otorga el fisco, no es automático (mismo motivo
  // por el que existe este flag y no se infiere de otra cosa). Gatilla si
  // WithholdingRegime de ese taxType puede crearse/aplicarse (ver
  // libs/modules/taxes's WithholdingRegimeService) - false por defecto, un
  // tenant que no toca esto sigue sin ver nada de retenciones en la UI.
  withholdingAgentIncomeTax   Boolean @default(false)
  withholdingAgentVat         Boolean @default(false)
  withholdingAgentGrossIncome Boolean @default(false)

  // AFIP WSFE (facturación electrónica) - certificado y clave privada del
  // tenant, cifrados con EncryptionService (AES-256-GCM) antes de persistir
  // (ver TenantSettingsService). Reemplaza AFIP_CERT_PATH/AFIP_KEY_PATH/
  // AFIP_ENV, que hoy son variables de entorno del proceso: un solo CUIT
  // para toda la instancia, incompatible con multi-tenant. El CUIT en sí ya
  // vive en Tenant.taxId y el Punto de Venta en Company.pointOfSaleNumber
  // (la sucursal BRANCH bajo la que se factura) - acá sólo falta lo que
  // identifica *cómo* hablarle a AFIP.
  afipEnv           AfipEnvironment @default(HOMOLOGACION)
  afipCertEncrypted String?
  afipKeyEncrypted  String?
  // Vencimiento del certificado, en claro (no es secreto) - permite avisar
  // "vence en N días" en Preferencias sin descifrar el certificado en cada
  // carga de pantalla.
  afipCertExpiresAt DateTime?

  // Condición IVA propia del tenant (quien emite), no la del cliente -
  // determina qué letra de comprobante es fiscalmente válida (ver
  // resolveDocumentLetter en @plexo/invoicing): Responsable Inscripto puede
  // emitir A o B según el cliente; Monotributo/Exento siempre emite C. A
  // diferencia de Company.taxCondition (texto libre, best-effort desde el
  // padrón de un tercero), esto lo declara el propio usuario a mano sobre
  // sí mismo - por eso es un enum cerrado, no texto libre. Nullable a
  // propósito (null = todavía no configurado): sin este dato no hay letra
  // que derivar con certeza, la UI cae a selección manual sin sugerencia.
  ownTaxCondition TenantTaxCondition?

  // Datos fiscales del emisor que van impresos en el PDF de Facturación
  // (ver @plexo/invoicing/pdf) - ninguno de los tres existía en el schema
  // hasta ahora. `Tenant.name`/`Tenant.taxId` ya cubren razón social/CUIT,
  // y `ownTaxCondition` arriba la condición IVA propia; sólo faltaban
  // estos tres. Nullable a propósito (null = todavía no cargado en
  // Preferencias) - el PDF simplemente omite la línea si no está.
  fiscalAddress      String?
  grossIncomeNumber  String?
  activityStartDate  DateTime?

  // Sugerencia genérica de remarca (%) para cuando un Article no tiene la
  // suya propia (Article.markupPercent) - null = sin sugerencia en
  // absoluto para esos casos. Ver ese campo para el resto del criterio.
  defaultMarkupPercent Decimal? @db.Decimal(6, 2)

  updatedAt DateTime @updatedAt

  @@map("tenant_settings")
}

model User {
  id                       String     @id @default(uuid())
  tenantId                 String
  email                    String
  passwordHash             String
  role                     UserRole   @default(VIEWER)
  // Suspender a un compañero de equipo (ver UsersService.toggleStatus) le
  // corta el login (chequeado en AuthService.login, mismo criterio que
  // Tenant.status) sin borrar sus registros históricos - eje administrativo
  // separado del rol, igual relación que TenantStatus tiene con Tenant.
  status                   UserStatus @default(ACTIVE)
  isExternalAccountant     Boolean    @default(false)
  // True para un usuario recién invitado (ver UsersService.inviteUser) con
  // una contraseña temporal - MustChangePasswordGuard bloquea el resto de
  // la API hasta que pase por /auth/change-password, que lo limpia a false.
  mustChangePassword       Boolean    @default(false)
  name                     String?
  avatarUrl                String?
  // Opt-in: whether this user's online/offline state is broadcast to
  // tenant-mates over the dashboard WebSocket (see DashboardGateway).
  // Off by default would mean nobody's presence shows until they opt in;
  // on by default matches how presence indicators normally work elsewhere
  // and is easy to turn off from the profile screen.
  showOnlinePresence       Boolean    @default(true)
  // Per-user document numbering for Compras (see QuoteRequest/PurchaseOrder)
  // - deliberately a separate series per user, not one shared per tenant
  // (decision with the user, 2026-07-27): each buyer identifies their own
  // requests/orders their own way. Format is always "{prefix}-{next
  // padded to 6 digits}"; *NextNumber holds the number to use NEXT (bumped
  // atomically via Prisma's `{ increment: 1 }`, not read-then-write, so
  // it's race-free unlike Invoice.number - see nextInvoiceNumber's docstring
  // in invoicing.service.ts for the pattern this deliberately improves on).
  quoteRequestPrefix       String     @default("PED")
  quoteRequestNextNumber   Int        @default(1)
  purchaseOrderPrefix      String     @default("OC")
  purchaseOrderNextNumber  Int        @default(1)
  // Default template for "Descargar PDF" on a QuoteRequest/PurchaseOrder;
  // overridable per-download without persisting (see PurchasesController).
  purchaseDocumentPdfStyle PdfStyle   @default(MODERNO)
  // Formato de papel por defecto para "Descargar PDF" en Facturación
  // (A4/A5/ticket angosto para impresora térmica) - mismo criterio que
  // purchaseDocumentPdfStyle arriba, overridable por descarga sin
  // persistir (ver InvoiceDetailPanel). A diferencia de Compras/Cotizaciones
  // (5 estilos visuales libres), acá el diseño es uno solo fiel al formato
  // real de ARCA - lo que varía es el tamaño de papel, no el estilo.
  invoicePdfFormat         InvoicePdfFormat @default(A4)
  // Same per-user numbering/PDF-style pattern as the Compras fields above,
  // for Cotizaciones (@plexo/quotes) - a separate series on purpose, not
  // shared with quoteRequestPrefix even though both start from "cotización"
  // in Spanish; they're unrelated documents (see the comment on model
  // Quote/QuoteRequest).
  quotePrefix              String     @default("PRE")
  quoteNextNumber          Int        @default(1)
  quotePdfStyle            PdfStyle   @default(MODERNO)
  createdAt                DateTime   @default(now())
  // null = todavía no verificado. Backfill a createdAt para toda fila
  // existente al momento de esta migración (ver 20260826000000_auth_onboarding)
  // - el gate de verificación sólo aplica a cuentas nuevas del signup público,
  // nunca a las ya creadas por seed/admin backoffice.
  emailVerifiedAt          DateTime?

  moduleAccess               UserModuleAccess[]
  issuedInvoices             Invoice[]
  issuedCreditNotes          CreditNote[]
  createdJournalEntries      JournalEntry[]
  createdQuoteRequests       QuoteRequest[]
  createdPurchaseOrders      PurchaseOrder[]
  receivedGoodsReceipts      GoodsReceipt[]
  returnedSupplierReturns    SupplierReturn[]
  createdPurchaseInvoices    PurchaseInvoice[]
  createdPurchaseCreditNotes PurchaseCreditNote[]
  recordedSupplierPayments   SupplierPayment[]
  createdChecks              Check[]
  createdBankStatementImports BankStatementImport[]
  createdInflationAdjustments InflationAdjustment[]
  cartItems                  InventoryCartItem[]
  createdQuotes              Quote[]
  emailVerificationCode      EmailVerificationCode?
  passwordResetTokens        PasswordResetToken[]
  oauthAccounts              OAuthAccount[]
  cashSessionsOpened         CashSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed         CashSession[] @relation("CashSessionClosedBy")
  cashMovements              CashMovement[]
  membershipLinkAsLinkedUser TenantMembershipLink[] @relation("MembershipLinkedUser")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Un código activo por usuario a la vez - reenviar (resendCode) sobreescribe
// el mismo row en vez de acumular filas viejas, evita la pregunta de "cuál
// de los 3 códigos es el vigente". codeHash es sha256 (no bcrypt) porque la
// defensa real es attemptCount, no el costo de hashing - el código sólo vive
// unos minutos.
model EmailVerificationCode {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  codeHash     String
  expiresAt    DateTime
  attemptCount Int      @default(0)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@map("email_verification_codes")
}

// Append-only a propósito (a diferencia de EmailVerificationCode) - un link
// de reseteo de contraseña puede quedar sin clickear y no debe desaparecer;
// usedAt lo invalida sin borrarlo. AuthService.forgotPassword marca como
// usado cualquier token previo sin usar del mismo usuario al crear uno
// nuevo, para que un link viejo nunca quede vigente en simultáneo con el
// último enviado.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

// Mismo patrón append-only que PasswordResetToken: invitar de nuevo al mismo
// email invalida (usedAt) cualquier invitación previa sin usar en vez de
// borrarla. No hay relación a User porque el invitado todavía no tiene fila
// propia - UsersService.acceptInvitation es quien la crea recién al aceptar.
model TeamInvitation {
  id              String    @id @default(uuid())
  tenantId        String
  email           String
  role            UserRole
  tokenHash       String
  expiresAt       DateTime
  usedAt          DateTime?
  invitedByUserId String
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([tokenHash])
  @@map("team_invitations")
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
  APPLE
}

// 0, 1 o 2 filas por usuario (un provider vinculado como mucho una vez cada
// uno). providerAccountId es el id estable que entrega cada proveedor (el
// "sub" de Google, el "oid" de Microsoft) - nunca el email, que puede
// cambiar del lado del proveedor sin que la cuenta deje de ser la misma.
model OAuthAccount {
  id                String        @id @default(uuid())
  tenantId          String
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  provider          OAuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([tenantId])
  @@index([userId])
  @@map("oauth_accounts")
}

model UserModuleAccess {
  id       String  @id @default(uuid())
  tenantId String
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  module   String
  canRead  Boolean @default(true)
  canWrite Boolean @default(false)

  @@unique([userId, module])
  @@index([tenantId])
  @@map("user_module_access")
}

enum CompanyRoleType {
  CUSTOMER
  SUPPLIER
  BRANCH
}

// Generic internal categorization for reporting/filtering - deliberately
// NOT AFIP's own "Actividades" nomenclador (that's a much larger,
// hierarchical, per-CUIT registry meant for tax purposes, not this). A
// closed enum (vs free text like taxCondition) trades flexibility for
// consistent filtering; OTRO is the catch-all for whatever doesn't fit.
enum CompanyIndustry {
  COMERCIO
  SERVICIOS
  INDUSTRIA
  CONSTRUCCION
  AGRO
  TECNOLOGIA
  SALUD
  EDUCACION
  GASTRONOMIA
  TRANSPORTE
  INMOBILIARIO
  OTRO
}

// Unifies what used to be a Customer-only table: any external company the
// tenant deals with (as a customer and/or a supplier) plus the tenant's
// own branches/points of sale - all three are "a company", just playing
// different roles (see CompanyRole, many-to-many: a distributor can be
// both a customer and a supplier at once). pointOfSaleNumber only means
// something for a BRANCH (the AFIP punto de venta invoices are issued
// under); it's simply unused for CUSTOMER/SUPPLIER rows.
model Company {
  id                   String           @id @default(uuid())
  tenantId             String
  name                 String
  taxId                String?
  email                String?
  creditLimit          Decimal          @default(0) @db.Decimal(14, 2)
  pointOfSaleNumber    String?
  // Best-effort label from AFIP's padrón lookup (ws_sr_padron_a13, see
  // libs/modules/companies/afip-padron.port.ts), persisted here since
  // 2026-07-23 - previously shown only at lookup time, lost on refresh.
  // Not re-validated/refreshed automatically; stays whatever it was the
  // last time someone hit "Buscar en AFIP" and saved. Not a closed enum
  // on purpose - AFIP's own categories change over time (see
  // AfipPadronData.taxCondition for the same reasoning).
  taxCondition         String?
  fiscalAddress        String?
  industry             CompanyIndustry?
  // Ingresos Brutos (provincial gross-income tax) registration number -
  // independent of taxId/CUIT (national), used alongside it for
  // provincial retenciones/percepciones. Free text: format varies by
  // jurisdiction (Convenio Multilateral vs local).
  grossIncomeNumber    String?
  // Whether this company is an AFIP/ARBA-appointed withholding agent for
  // each tax - three independent flags, not one generic "tiene
  // retenciones" boolean, because a company can be appointed for one
  // regime and not another (e.g. retiene IVA but no Ganancias). Matters
  // mainly for CUSTOMER companies: one flagged here may pay an invoice
  // short and hand over a certificado de retención for the difference
  // instead of the missing amount being a real discrepancy. Purely
  // informational for now - nothing in Receivables reads these yet, it's
  // just visible on the company record.
  withholdsVat         Boolean          @default(false)
  withholdsIncomeTax   Boolean          @default(false)
  withholdsGrossIncome Boolean          @default(false)
  // URL only, no upload/storage infra - same convention as
  // User.avatarUrl/Person.avatarUrl.
  logoUrl              String?
  // Soft delete: a Company can be referenced by historical fiscal records
  // (Invoice/Quote have no onDelete cascade on purpose - see the migration
  // for why), so "deleting" one means hiding it from active use, not
  // removing the row. Historical reports/statements deliberately ignore
  // this flag; anything that creates a NEW forward-looking record against
  // the company (a new invoice, resolving a branch for a new sale) checks
  // it and rejects if false.
  active               Boolean          @default(true)
  createdAt            DateTime         @default(now())

  roles  CompanyRole[]
  people Person[]

  // Relation field on Invoice/Quote is kept named `customer` (not renamed
  // to `company`) so every existing `include: { customer: true }` /
  // `invoice.customer.name` call site across Invoicing/Receivables/Reports
  // keeps working unchanged - only the model/table the FK targets changed.
  invoices Invoice[]
  quotes   Quote[]

  // A Company playing the SUPPLIER role can be the counterparty of a
  // Compras document - unrelated to the `quotes`/`Quote` field above
  // (sales-side presupuesto), see QuoteRequest for why the names differ.
  quoteRequests        QuoteRequest[]
  purchaseOrders       PurchaseOrder[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseCreditNotes  PurchaseCreditNote[]
  // Articles that name this Company as their preferred supplier (see
  // Article.preferredSupplierId) - read from the Company side (e.g. "what
  // do we usually buy from this supplier") without CompaniesService
  // importing InventoryService, per the module-boundary rule (queries
  // the articles table directly via getTenantDb()).
  preferredForArticles Article[]
  // Cheques donde esta Company es quien libró el cheque de tercero
  // (cliente) o a quien se le endosó/pagó (proveedor) - ver model Check.
  checksAsCustomer     Check[]              @relation("CheckCustomer")
  checksAsSupplier     Check[]              @relation("CheckSupplier")
  // Cajas de mostrador cuya sucursal (rol BRANCH) es esta Company - ver
  // model CashRegister.
  cashRegisters        CashRegister[]

  @@index([tenantId])
  @@map("companies")
}

model CompanyRole {
  id        String          @id @default(uuid())
  tenantId  String
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  role      CompanyRoleType

  @@unique([tenantId, companyId, role])
  @@index([tenantId, role])
  @@map("company_roles")
}

// Contact person at a customer or supplier company (not meaningful for a
// BRANCH - that's the tenant's own location, not an external contact).
// Nothing enforces that at the schema level; CompaniesService is where
// that rule actually lives.
model Person {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  firstName String
  lastName  String?
  nickname  String?
  email     String?
  whatsapp  String?
  avatarUrl String?
  jobTitle  String?
  createdAt DateTime @default(now())

  @@index([tenantId, companyId])
  @@map("people")
}

// --- Currency ---

// Pricing reference is USD (ArticleVariant.unitPrice) per the invoicing
// design; invoices are denominated in whichever Currency the tenant issues
// in (typically ARS), converting at Invoice.exchangeRate - which is locked
// at issuance, never recomputed from here afterward.
model Currency {
  id       String  @id @default(uuid())
  tenantId String
  code     String
  name     String
  isBase   Boolean @default(false)

  exchangeRates       ExchangeRateHistory[]
  invoices            Invoice[]
  creditNotes         CreditNote[]
  quoteRequests       QuoteRequest[]
  purchaseOrders      PurchaseOrder[]
  purchaseInvoices    PurchaseInvoice[]
  purchaseCreditNotes PurchaseCreditNote[]
  quotes              Quote[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("currencies")
}

// Append-only, like PriceHistory - never update a rate in place, insert a
// new one. Rate is expressed as units of `currency` per 1 USD.
model ExchangeRateHistory {
  id          String   @id @default(uuid())
  tenantId    String
  currencyId  String
  currency    Currency @relation(fields: [currencyId], references: [id])
  rate        Decimal  @db.Decimal(18, 6)
  effectiveAt DateTime @default(now())

  @@index([tenantId, currencyId, effectiveAt])
  @@map("exchange_rate_history")
}

// --- Inventory ---

// Self-referential so category depth isn't hardcoded to 2 levels
// (Category/Subcategory) - a chain of parentId links supports any depth
// without a schema change later.
model Category {
  id       String     @id @default(uuid())
  tenantId String
  name     String
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  articles Article[]

  @@unique([tenantId, parentId, name])
  @@index([tenantId])
  @@map("categories")
}

// The catalog-level entry (name, unit, category, tax). Never sold or
// stocked directly - ArticleVariant is the sellable/stocked unit, even
// for articles with no real variation (see ArticleVariant comment).
model Article {
  id                  String         @id @default(uuid())
  tenantId            String
  name                String
  description         String?
  unitOfMeasure       UnitOfMeasure  @default(UNIT)
  categoryId          String?
  category            Category?      @relation(fields: [categoryId], references: [id])
  taxDefinitionId     String?
  taxDefinition       TaxDefinition? @relation(fields: [taxDefinitionId], references: [id])
  // A service doesn't move stock - InventoryService should reject
  // PURCHASE_IN/SALE_OUT/etc. movements against its variants (not enforced
  // yet, see pendiente en PROGRESS.md).
  isService           Boolean        @default(false)
  // Whether this article is meant to be shown in a future customer-facing
  // storefront. No storefront exists yet - this only records the intent.
  isPublished         Boolean        @default(false)
  // Real uploaded file (see POST/DELETE /inventory/articles/:id/image),
  // not a pasted URL like User.avatarUrl/Person.avatarUrl - first real
  // file-storage feature in the project (2026-07-27 decision with the
  // user). Served unauthenticated from a random-uuid filename, see
  // main.ts's @fastify/static registration - a deliberate, narrow
  // exception to "everything is tenant-scoped/RLS-protected", justified
  // because a product photo isn't fiscal/financial data.
  imageUrl            String?
  // One preferred supplier per article (decision with the user,
  // 2026-07-27): "who do we usually buy this from", set at the Article
  // level, not per ArticleVariant - a QuoteRequest/PurchaseOrder line
  // still targets a specific ArticleVariant regardless, this is just a
  // default/suggestion, not a constraint on which supplier a document
  // can actually use. Nullable - most articles won't have one set.
  preferredSupplierId String?
  preferredSupplier   Company?       @relation(fields: [preferredSupplierId], references: [id])
  // Override individual del % de remarca de este artículo (compartido por
  // todas sus variantes/SKU - decisión con el usuario, 2026-08-21: el
  // margen no suele variar entre talles/colores del mismo producto). Nulo
  // = usa TenantSettings.defaultMarkupPercent en su lugar; ninguno de los
  // dos configurado = sin sugerencia de precio, el precio de venta se
  // sigue cargando 100% a mano como hasta ahora. Sólo alimenta una
  // SUGERENCIA editable al cargar/editar el precio - nunca recalcula solo
  // un precio ya cargado (ver InventoryService.createArticleVariant /
  // updateArticleVariantPrice, sin cambios de comportamiento).
  markupPercent       Decimal?       @db.Decimal(6, 2)
  // Folleto (PDF) y adjunto ZIP opcionales del artículo - "dato extra", no
  // se muestran siempre, viven en su propio modal ("Detalles") en vez del
  // panel principal. Mismo patrón de archivo que imageUrl (disco local,
  // nombre random-uuid, servido sin autenticación vía @fastify/static) -
  // ver ArticleAttachmentsService.
  brochureUrl         String?
  attachmentZipUrl    String?
  // Marca informativa: "este artículo se vende en más de una variante real
  // (talle/color/etc.), no un SKU único disfrazado de artículo". No cambia
  // ninguna validación de backend por sí sola - un Article con
  // hasVariants=false sigue pudiendo tener más de un ArticleVariant (nunca
  // se fuerza a uno solo), sólo es lo que ArticleFormModal usa para decidir
  // si mostrar el creador de atributos/matriz o la alta simple de un SKU.
  hasVariants         Boolean        @default(false)
  createdAt           DateTime       @default(now())

  variants ArticleVariant[]

  @@index([tenantId])
  @@map("articles")
}

// The actual SKU-bearing, priced, stocked unit. An Article with no real
// variation still gets exactly one ArticleVariant (its "default" SKU) -
// this keeps stock/price/movement logic uniform instead of special-casing
// "articles without variants" throughout the codebase.
model ArticleVariant {
  id         String   @id @default(uuid())
  tenantId   String
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id])
  sku        String
  color      String?
  size       String?
  brand      String?
  // Pares clave/valor arbitrarios ("Color": "Rojo", "Talle": "M") para
  // variantes generadas desde el creador de atributos de ArticleFormModal -
  // más flexible que los 3 campos fijos de arriba (color/size/brand), que
  // quedan como estaban por compatibilidad con datos/imports viejos. Sin
  // validación de shape en la base (JSON libre) - InventoryService valida
  // que sea un objeto de string a string antes de guardar, no una lista de
  // atributos predefinida por tenant.
  attributes Json?
  unitPrice  Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  priceHistory       PriceHistory[]
  stockLedger        StockLedger[]
  minimumStocks      MinimumStock[]
  movements          StockMovement[]
  invoiceLines       InvoiceLine[]
  quoteLines         QuoteLine[]
  quoteRequestLines  QuoteRequestLine[]
  purchaseOrderLines PurchaseOrderLine[]
  cartItems          InventoryCartItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, articleId])
  @@map("article_variants")
}

// A single, persistent per-user "shopping list" over ArticleVariants - not
// an ecommerce session cart, doesn't expire/clear on its own. The user
// builds it up gradually (over days) while browsing the catalog, then uses
// its contents to seed a multi-supplier RFQ split (@plexo/purchases,
// via the inventory-cart-checkout composition module) and/or a sales Quote
// (@plexo/quotes) and/or a plain PDF export - none of those actions empty
// the list, only an explicit "vaciar" does (decision with the user,
// 2026-08-03: the same list is meant to serve more than one of those uses).
// One row per (user, variant) rather than a parent "cart" table - there's
// nothing to a cart beyond "this user's current rows", so a parent table
// would be a pure wrapper with no fields of its own.
model InventoryCartItem {
  id               String         @id @default(uuid())
  tenantId         String
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  articleVariantId String
  articleVariant   ArticleVariant @relation(fields: [articleVariantId], references: [id])
  quantity         Decimal        @db.Decimal(14, 3)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Lets "add to cart" be one atomic upsert (increment quantity if the
  // variant's already in the list) instead of a read-then-write.
  @@unique([tenantId, userId, articleVariantId])
  @@index([tenantId, userId])
  @@map("inventory_cart_items")
}

// Append-only price timeline, separate from AuditLog: this is a narrow,
// query-friendly table purpose-built for cost/margin-over-time reports,
// not a generic diff log.
model PriceHistory {
  id               String         @id @default(uuid())
  tenantId         String
  articleVariantId String
  articleVariant   ArticleVariant @relation(fields: [articleVariantId], references: [id])
  unitPrice        Decimal        @db.Decimal(14, 2)
  costPrice        Decimal?       @db.Decimal(14, 2)
  changedById      String?
  // Which Orden de Compra this cost came from, if the movement that
  // triggered this row referenced one (see
  // InventoryService.recordMovement, RecordStockMovementDto.purchaseOrderId)
  // - null for selling-price-only changes or a cost entered without
  // linking a purchase order. A real FK (not the loose sourceType/sourceId
  // pattern StockMovement uses for "any originating table") because
  // PurchaseOrder is a real, validated entity now - decision with the
  // user, 2026-07-27.
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  effectiveAt      DateTime       @default(now())

  @@index([tenantId, articleVariantId])
  @@map("price_history")
}

model Warehouse {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  location String?

  stockLedger   StockLedger[]
  minimumStocks MinimumStock[]
  movements     StockMovement[]
  goodsReceipts GoodsReceipt[]
  cashRegisters CashRegister[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("warehouses")
}

// --- Caja / POS (@plexo/pos) ---
// Módulo de mostrador (venta rápida + apertura/cierre de caja), aparte de
// Facturación (pensada para venta B2B con cuenta corriente completa) - ver
// PosService.checkout, que reusa SalesService.createSale/recordReceipt tal
// cual en vez de duplicar la lógica de factura/stock/asiento.

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  CASH_IN
  CASH_OUT
}

// Un mostrador/terminal físico. Siempre atado a una Company con rol BRANCH
// (define pointOfSaleNumber/AFIP) + un Warehouse (stock) + una
// FinancialAccount propia (provider CASH, 1:1) - el "cajón" de esa caja
// específica, separado de cualquier otra cuenta de efectivo del tenant.
// Multi-caja = N filas de esto por tenant, cada una con sus propias
// sesiones independientes.
model CashRegister {
  id                 String           @id @default(uuid())
  tenantId           String
  name               String
  branchId           String
  branch             Company          @relation(fields: [branchId], references: [id])
  warehouseId        String
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id])
  financialAccountId String           @unique
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())

  sessions CashSession[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("cash_registers")
}

// Un "turno" por caja. Sin dueño exclusivo (multi-cajero: cualquier
// usuario habilitado opera contra la sesión OPEN de su caja, ver
// CashMovement.createdByUserId para la auditoría por persona).
// expectedAmount/difference se snapshotean al cerrar (no se re-derivan
// después) - mismo criterio que Invoice.customerName/customerTaxId: un
// hecho de auditoría no debe poder cambiar de valor retroactivamente si
// algún día cambia cómo se suman los CashMovement. @@unique([tenantId, id])
// existe sólo para que JournalEntry pueda referenciarla por FK compuesta
// (tenantId, cashSessionId) - mismo criterio que Receipt/InflationAdjustment.
model CashSession {
  id             String            @id @default(uuid())
  tenantId       String
  registerId     String
  register       CashRegister      @relation(fields: [registerId], references: [id])
  status         CashSessionStatus @default(OPEN)
  openedByUserId String
  openedBy       User              @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  openingAmount  Decimal           @db.Decimal(14, 2)
  openedAt       DateTime          @default(now())
  closedByUserId String?
  closedBy       User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  countedAmount  Decimal?          @db.Decimal(14, 2)
  expectedAmount Decimal?          @db.Decimal(14, 2)
  difference     Decimal?          @db.Decimal(14, 2)
  closedAt       DateTime?
  notes          String?
  // Desglose de billetes/monedas del cierre, estilo Odoo (Fase 2) - sólo se
  // completa si el cajero usó el modo desglose en vez de tipear un total a
  // mano; nullable a propósito. Forma: { denomination: number; count: number }[].
  // Fuente de verdad real de countedAmount cuando está presente: el
  // servidor recalcula Σ(denomination × count) y lo usa en vez de confiar
  // en cualquier total que mande el cliente aparte (ver
  // CashSessionsService.closeSession) - nunca al revés.
  denominationBreakdown Json?
  // Simétrico a lo anterior pero para la APERTURA (Fase 3): desglose de
  // billetes/monedas con el que el cajero entrante contó el cajón, misma
  // forma que denominationBreakdown de arriba - también nullable a
  // propósito (sólo se completa si usó el modo desglose al abrir).
  openingDenominationBreakdown Json?
  // openingAmount de ESTA sesión menos countedAmount del último turno
  // CERRADO de la misma caja - rastro auditable de cuánto declaró el
  // cajero entrante contra lo que dejó contado el saliente. Null si es el
  // primer turno de la caja o si no hubo turno cerrado previo. Puramente
  // informativo: nunca bloquea la apertura (ver CashSessionsService.openSession).
  openingDifference            Decimal? @db.Decimal(14, 2)

  movements    CashMovement[]
  journalEntry JournalEntry?

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, registerId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id              String           @id @default(uuid())
  tenantId        String
  sessionId       String
  session         CashSession      @relation(fields: [sessionId], references: [id])
  type            CashMovementType
  // Efecto firmado sobre el cajón físico: positivo ingreso, negativo
  // egreso. Para SALE, sólo la porción en EFECTIVO de una venta con pago
  // dividido - tarjeta/MP/transferencia tienen su propio Receipt pero NO
  // generan CashMovement (no tocan el cajón).
  amount          Decimal          @db.Decimal(14, 2)
  invoiceId       String?
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  reason          String?
  createdByUserId String
  createdBy       User             @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime         @default(now())

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@map("cash_movements")
}

// Current balance per (warehouse, variant) - materialized and kept in sync
// with every StockMovement in the same DB transaction. StockMovement is the
// source of truth/history; this is the fast-read projection of it, not an
// independently-editable value.
model StockLedger {
  id               String         @id @default(uuid())
  tenantId         String
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  articleVariantId String
  articleVariant   ArticleVariant @relation(fields: [articleVariantId], references: [id])
  quantity         Decimal        @default(0) @db.Decimal(14, 3)
  // Running weighted-average unit cost (PPP), updated on every costed
  // inbound movement (PURCHASE_IN/PRODUCTION_IN/RETURN with a unitCost).
  // Null until the first costed inbound - see InventoryService.recordMovement.
  avgUnitCost      Decimal?       @db.Decimal(14, 4)
  updatedAt        DateTime       @updatedAt

  @@unique([warehouseId, articleVariantId])
  @@index([tenantId])
  @@map("stock_ledger")
}

model MinimumStock {
  id               String         @id @default(uuid())
  tenantId         String
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  articleVariantId String
  articleVariant   ArticleVariant @relation(fields: [articleVariantId], references: [id])
  minimumQuantity  Decimal        @db.Decimal(14, 3)
  // Opt-in, default false (comportamiento sin cambios) - ver
  // InventoryReplenishmentSchedulerService: el barrido diario crea un
  // Pedido de Cotización solo para las filas con esto en true, agrupando
  // por Article.preferredSupplierId (sin proveedor preferido no hay a
  // quién agrupar, esa fila no puede ser automática).
  autoReplenish    Boolean        @default(false)

  @@unique([warehouseId, articleVariantId])
  @@index([tenantId])
  @@map("minimum_stock")
}

// Immutable history of every stock in/out. sourceType/sourceId is a soft
// (non-FK) pointer to whatever originated it (purchase order, production
// order, manual adjustment...) since that can be any table; invoiceId stays
// a real FK for the sales path specifically, since Invoice already models
// that relation elsewhere (Invoice.movements).
model StockMovement {
  id                 String            @id @default(uuid())
  tenantId           String
  warehouseId        String
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id])
  articleVariantId   String
  articleVariant     ArticleVariant    @relation(fields: [articleVariantId], references: [id])
  type               MovementType
  quantity           Decimal           @db.Decimal(14, 3)
  // Cost snapshot for this specific movement: for costed inbound types,
  // the unit cost provided by the caller; for SALE_OUT/PRODUCTION_OUT, the
  // StockLedger.avgUnitCost consumed at that moment (never recomputed
  // later). Null for ADJUSTMENT and any uncosted movement.
  unitCost           Decimal?          @db.Decimal(14, 4)
  sourceType         String?
  sourceId           String?
  invoiceId          String?
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  // Which invoice line this SALE_OUT movement came out of - set by
  // SalesService.createSale. Lets voidSale find "the movement for THIS
  // line" instead of only "all movements for this invoice", which partial
  // credit notes need (restock/re-cost just the credited quantity, not the
  // whole invoice). Null for movements with no invoice line (manual
  // PURCHASE_IN/ADJUSTMENT/etc.).
  invoiceLineId      String?
  invoiceLine        InvoiceLine?      @relation(fields: [invoiceLineId], references: [id])
  // Which GoodsReceiptLine (remito) this PURCHASE_IN movement came from -
  // same role as invoiceLineId above but for the purchases side. Set by
  // GoodsReceiptsService (apps/api) when it drives recordMovement() per
  // line of a received remito. Null for movements entered manually.
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  createdAt          DateTime          @default(now())

  @@index([tenantId])
  @@index([tenantId, articleVariantId])
  @@map("stock_movements")
}

// Populated exclusively by Postgres triggers (see the
// row_level_security/audit migrations), never by application code - see
// the inventory module notes on why triggers instead of Prisma middleware.
model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  tableName String
  recordId  String
  action    AuditAction
  changedBy String?
  changes   Json
  createdAt DateTime    @default(now())

  @@index([tenantId, tableName, recordId])
  @@map("audit_log")
}

enum ActivityOutcome {
  SUCCESS
  FAILURE
}

// Application-level "who did what, when, from where" log - distinct from
// AuditLog above, which is a DB-trigger row-change log with no IP/session
// info (that only exists at the HTTP layer, triggers can't see it).
// Populated by ActivityLogInterceptor (apps/api) for mutating requests,
// and directly by AuthService for login attempts specifically, since
// those happen before TenantContextInterceptor establishes any context
// for the interceptor to piggyback on.
model UserActivityLog {
  id           String          @id @default(uuid())
  tenantId     String
  userId       String?
  action       String
  outcome      ActivityOutcome
  ip           String?
  userAgent    String?
  errorMessage String?
  // Populated only for routes decorated with @AuditEntity (see
  // audit-entity.decorator.ts) - undecorated routes leave these null and
  // keep the plain "METHOD /url" action string, exactly as before this
  // field existed.
  entityType   String? // Prisma model name, e.g. "company" - plain String on
  // purpose (not an enum): auditing a new entity is a decorator, not a migration.
  entityId     String?
  entityLabel  String? // display value only (e.g. "Acme S.A."); the verb/noun
  // phrasing happens at read time (ActivityLogService), not here.
  changes      Json? // {"taxId": {"from": "20-111...", "to": "20-222..."}} - see
  // computeDiff in audit-diff.ts. Only ever set on outcome SUCCESS.
  createdAt    DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("user_activity_log")
}

// Once afipCae is set, this row is fiscally locked (see the
// invoice-immutability migration): every column except balanceDue/status
// becomes read-only, even for admins. Corrections after that point are a
// CreditNote referencing this invoice, never an UPDATE.
model Invoice {
  id                    String         @id @default(uuid())
  tenantId              String
  customerId            String
  customer              Company        @relation(fields: [customerId], references: [id])
  // Snapshot of the customer at issuance - required for fiscal documents:
  // Company.name/taxId can change later, the invoice must not silently
  // change with it.
  customerName          String
  customerTaxId         String?
  documentLetter        DocumentLetter
  // AFIP Concepto (1/2/3, ver InvoiceConcept) - derivado de Article.isService
  // de cada línea al crear la factura (InvoicingService.createInvoice), no
  // elegido por el usuario. Persistido acá (no re-derivado cada vez) porque
  // CreditNote lo reusa tal cual del Invoice que acredita - una nota de
  // crédito reversa las mismas líneas, así que es el mismo concepto por
  // definición, sin necesidad de volver a mirar los artículos.
  concept               InvoiceConcept @default(PRODUCTOS)
  pointOfSale           String
  number                String
  status                InvoiceStatus  @default(DRAFT)
  issueDate             DateTime       @default(now())
  dueDate               DateTime?
  currencyId            String
  currency              Currency       @relation(fields: [currencyId], references: [id])
  // USD -> currency, locked at issuance - never recompute retroactively.
  exchangeRate          Decimal        @db.Decimal(18, 6)
  globalDiscountPercent Decimal        @default(0) @db.Decimal(5, 2)
  subtotal              Decimal        @db.Decimal(14, 2)
  taxTotal              Decimal        @db.Decimal(14, 2)
  total                 Decimal        @db.Decimal(14, 2)
  balanceDue            Decimal        @db.Decimal(14, 2)
  afipCae               String?
  afipCaeExpiry         DateTime?
  issuedByUserId        String
  issuedBy              User           @relation(fields: [issuedByUserId], references: [id])
  // Last time ReceivablesSchedulerService emailed an overdue alert for this
  // invoice (the first time it crosses into OVERDUE, and again every
  // TenantSettings.arReminderIntervalDays if recurring reminders are on -
  // see ReceivablesService.sendRecurringReminders). Null means "never
  // reminded yet". Exempted from invoice_fiscal_lock the same way
  // balanceDue/status are - it has to keep moving on an already-issued
  // (CAE'd) invoice, since that's exactly when reminders fire.
  lastOverdueReminderAt DateTime?

  lines        InvoiceLine[]
  movements    StockMovement[]
  journalEntry JournalEntry?
  receipts     Receipt[]
  creditNotes  CreditNote[]
  // Venta cobrada en efectivo desde Caja/POS - ver CashMovement.invoiceId.
  // Opcional: una factura de Facturación normal (fuera de POS) nunca tiene
  // ninguno.
  cashMovements CashMovement[]
  taxLines      InvoiceTaxLine[]

  @@unique([tenantId, documentLetter, pointOfSale, number])
  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("invoices")
}

// Percepciones/otros tributos cobrados en una factura de venta (ej.
// Percepción IIBB) - hermano de PurchaseInvoiceTaxLine, pero a diferencia
// de ese (transcripción libre de lo que cobró un proveedor, nunca
// transmitido), esta tabla sí se manda de verdad a AFIP en
// FECAESolicitar (ver InvoicingService.createInvoice/AfipWsfeClient).
model InvoiceTaxLine {
  id        String             @id @default(uuid())
  tenantId  String
  invoiceId String
  invoice   Invoice            @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  kind      InvoiceTaxLineKind
  concept   String
  // Base imponible y alícuota del tributo (AFIP BaseImp/Alic) - opcionales:
  // no todo tributo se expresa como base*alícuota (ej. una tasa municipal
  // fija). amount es siempre lo que realmente se cobra (AFIP Importe).
  baseAmount Decimal? @db.Decimal(14, 2)
  rate       Decimal? @db.Decimal(5, 2)
  amount     Decimal  @db.Decimal(14, 2)

  @@index([tenantId])
  @@map("invoice_tax_lines")
}

model InvoiceLine {
  id               String         @id @default(uuid())
  tenantId         String
  invoiceId        String
  invoice          Invoice        @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  articleVariantId String
  articleVariant   ArticleVariant @relation(fields: [articleVariantId], references: [id])
  quantity         Decimal        @db.Decimal(14, 3)
  // Already converted to the invoice's currency (articleVariant.unitPrice
  // in USD x Invoice.exchangeRate), before any discount.
  unitPrice        Decimal        @db.Decimal(14, 2)
  discountType     DiscountType   @default(PERCENTAGE)
  discountValue    Decimal        @default(0) @db.Decimal(14, 2)
  // quantity*unitPrice net of discountType/discountValue, pre-tax,
  // pre-global-discount - kept for auditability instead of only storing
  // the final lineTotal, since the calculation chain has multiple stages.
  netAmount        Decimal        @db.Decimal(14, 2)
  taxRate          Decimal        @db.Decimal(5, 2)
  // GRAVADO (default) = netAmount entra en ImpNeto/Iva[] de AFIP, igual que
  // siempre. EXENTO/NO_GRAVADO = netAmount entra en ImpOpEx/ImpTotConc en
  // cambio, fuera del breakdown de IVA - ver TaxCalculationType. Persistido
  // por línea (no re-derivado del artículo) para que createCreditNote pueda
  // reusarlo al acreditar parcialmente sin volver a resolver el
  // TaxDefinition de cada artículo, mismo motivo que Invoice.concept.
  taxKind          TaxLineKind    @default(GRAVADO)
  lineTotal        Decimal        @db.Decimal(14, 2)

  creditNoteLines CreditNoteLine[]
  stockMovements  StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("invoice_lines")
}

// A correction to an already-issued Invoice. Never an UPDATE to the
// original - the trigger enforces that once an Invoice has a CAE, it's
// read-only, so any adjustment (return, pricing error, cancellation) has
// to be its own fiscal document, linked back via invoiceId.
model CreditNote {
  id             String         @id @default(uuid())
  tenantId       String
  invoiceId      String
  invoice        Invoice        @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  documentLetter DocumentLetter
  pointOfSale    String
  number         String
  reason         String
  currencyId     String
  currency       Currency       @relation(fields: [currencyId], references: [id])
  exchangeRate   Decimal        @db.Decimal(18, 6)
  subtotal       Decimal        @db.Decimal(14, 2)
  taxTotal       Decimal        @db.Decimal(14, 2)
  total          Decimal        @db.Decimal(14, 2)
  afipCae        String?
  afipCaeExpiry  DateTime?
  issuedByUserId String
  issuedBy       User           @relation(fields: [issuedByUserId], references: [id])
  issueDate      DateTime       @default(now())

  lines        CreditNoteLine[]
  journalEntry JournalEntry?

  @@unique([tenantId, documentLetter, pointOfSale, number])
  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])
  @@map("credit_notes")
}

// One row per (InvoiceLine, credited quantity) - a credit note always
// targets specific invoice lines, never "the whole invoice" as a separate
// concept: crediting every line's full quantity IS what used to be called
// "full reversal", same code path. Multiple CreditNoteLine rows across
// different CreditNotes can point at the same InvoiceLine (partial returns
// over time) - InvoicingService.createCreditNote sums them to enforce that
// total credited quantity never exceeds InvoiceLine.quantity.
model CreditNoteLine {
  id            String      @id @default(uuid())
  tenantId      String
  creditNoteId  String
  creditNote    CreditNote  @relation(fields: [creditNoteId], references: [id])
  invoiceLineId String
  invoiceLine   InvoiceLine @relation(fields: [tenantId, invoiceLineId], references: [tenantId, id])
  quantity      Decimal     @db.Decimal(14, 3)
  // Proportional slice of the InvoiceLine's netAmount/tax/lineTotal for
  // this credited quantity - same computed-field shape as InvoiceLine.
  netAmount     Decimal     @db.Decimal(14, 2)
  taxAmount     Decimal     @db.Decimal(14, 2)
  lineTotal     Decimal     @db.Decimal(14, 2)

  @@index([tenantId])
  @@index([invoiceLineId])
  @@map("credit_note_lines")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

// Mirrors PurchaseSendChannel exactly but kept separate on purpose - no
// module imports another module's types/services here, see the comment
// on PurchaseEmailSender for the same rule applied to email senders.
enum QuoteSendChannel {
  EMAIL
  WHATSAPP
}

// "Cotización" - a sales-side proposal to a customer (@plexo/quotes).
// Deliberately unrelated to QuoteRequest/PurchaseOrder (@plexo/purchases,
// see the comment above that section) - same "cotización" word, different
// document, different lib, on purpose. Was a bare unused skeleton from the
// very first migration until 2026-08-03 - extended here to match the depth
// QuoteRequest already has (currency, notes, creator, sent tracking,
// real status enum) when the module was actually implemented.
model Quote {
  id              String      @id @default(uuid())
  tenantId        String
  // "{createdBy.quotePrefix}-{n padded to 6}" - same frozen-at-creation
  // per-user numbering as QuoteRequest.number, see User fields below.
  number          String
  customerId      String
  customer        Company     @relation(fields: [customerId], references: [id])
  status          QuoteStatus @default(DRAFT)
  currencyId      String
  currency        Currency    @relation(fields: [currencyId], references: [id])
  validUntil      DateTime?
  notes           String?
  brandingLogoUrl String?
  total           Decimal     @db.Decimal(14, 2)

  // How/whether this was sent to the customer - same "user-confirmed, no
  // delivery receipt" semantics as PurchaseOrder.sentAt/sentVia.
  sentAt  DateTime?
  sentVia QuoteSendChannel?

  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  lines QuoteLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("quotes")
}

model QuoteLine {
  id               String         @id @default(uuid())
  tenantId         String
  quoteId          String
  quote            Quote          @relation(fields: [quoteId], references: [id])
  articleVariantId String
  articleVariant   ArticleVariant @relation(fields: [articleVariantId], references: [id])
  quantity         Decimal        @db.Decimal(14, 3)
  unitPrice        Decimal        @db.Decimal(14, 2)
  notes            String?
  // IVA por línea - nullable a propósito, sin backfill: cotizaciones
  // creadas antes de este campo no tenían noción de IVA (Quote.total era
  // sólo ΣunitPrice×quantity). Mismo criterio que PurchaseInvoiceTaxLine.
  // netAmount/lineTotal ya reflejan si el precio ingresado era neto o con
  // IVA incluido (ver QuoteService.create) - unitPrice de arriba queda
  // siempre en términos netos una vez resuelto.
  taxRate          Decimal?       @db.Decimal(5, 2)
  taxKind          TaxLineKind?
  netAmount        Decimal?       @db.Decimal(14, 2)
  lineTotal        Decimal?       @db.Decimal(14, 2)

  @@index([tenantId])
  @@map("quote_lines")
}

model Receipt {
  id                 String            @id @default(uuid())
  tenantId           String
  invoiceId          String
  invoice            Invoice           @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  amount             Decimal           @db.Decimal(14, 2)
  method             String
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  paidAt             DateTime          @default(now())

  journalEntry JournalEntry?
  // El cheque de tercero que este Recibo trajo a cartera, si se cobró con
  // cheque - ver model Check.
  check        Check?

  @@unique([tenantId, id])
  @@map("receipts")
}

model AccountingAccount {
  id       String      @id @default(uuid())
  tenantId String
  code     String
  name     String
  type     AccountType
  // Ajuste por Inflación (RT6/NC39) - sólo ASSET/LIABILITY/EQUITY participan
  // del cálculo de posición monetaria neta (InflationAdjustmentService); en
  // INCOME/EXPENSE este flag queda inerte por diseño. Default true (la
  // mayoría de las cuentas hoy son monetarias) - la única cuenta hardcodeada
  // no monetaria es Mercaderías (bien de cambio), corregida en la migración.
  isMonetary Boolean @default(true)

  lines JournalEntryLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("accounting_accounts")
}

// Posted entries are immutable (see the journal-entry-lock migration) -
// correcting one is a reversing entry (same lines, DEBIT/CREDIT swapped),
// linked via reversalOfId, never an UPDATE to the original.
model JournalEntry {
  id                   String              @id @default(uuid())
  tenantId             String
  invoiceId            String?             @unique
  invoice              Invoice?            @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  // One entry per credit note, resolved-or-created the same way the sale's
  // entry is resolved by invoiceId - NOT via reversalOfId/createReversingEntry,
  // since a credit note posts its own independently-balanced (possibly
  // partial) entry rather than a 100% mirror of a prior one, and both
  // invoiceId/reversalOfId being @unique would block a second partial
  // credit note from ever linking back to the same original sale entry.
  creditNoteId         String?             @unique
  creditNote           CreditNote?         @relation(fields: [tenantId, creditNoteId], references: [tenantId, id])
  // Compras/Cuentas a Pagar - same one-entry-per-document precedent as
  // invoiceId/creditNoteId above, not a polymorphic sourceType/sourceId:
  // each of these needs its own uniqueness guarantee (a goods receipt's
  // GRNI accrual, a supplier return's partial reversal, a purchase
  // invoice's clearing entry, a payment's cash entry are each posted at
  // most once). See AccountingService.postGoodsReceiptAccrual /
  // reverseSupplierReturnAccrual / postPurchaseInvoiceJournalEntry /
  // postSupplierPaymentJournalEntry.
  goodsReceiptId       String?             @unique
  goodsReceipt         GoodsReceipt?       @relation(fields: [tenantId, goodsReceiptId], references: [tenantId, id])
  supplierReturnId     String?             @unique
  supplierReturn       SupplierReturn?     @relation(fields: [tenantId, supplierReturnId], references: [tenantId, id])
  purchaseInvoiceId    String?             @unique
  purchaseInvoice      PurchaseInvoice?    @relation(fields: [tenantId, purchaseInvoiceId], references: [tenantId, id])
  // Mirror-image entry of a Nota de Crédito de Compra - same one-per-document
  // precedent as purchaseInvoiceId right above. See
  // AccountingService.postPurchaseCreditNoteJournalEntry.
  purchaseCreditNoteId String?             @unique
  purchaseCreditNote   PurchaseCreditNote? @relation(fields: [tenantId, purchaseCreditNoteId], references: [tenantId, id])
  supplierPaymentId    String?             @unique
  supplierPayment      SupplierPayment?    @relation(fields: [tenantId, supplierPaymentId], references: [tenantId, id])
  // AR equivalent of supplierPaymentId above: one entry per customer
  // Receipt (Dr Caja / Cr Deudores por Ventas). See
  // AccountingService.postReceiptJournalEntry.
  receiptId            String?             @unique
  receipt              Receipt?            @relation(fields: [tenantId, receiptId], references: [tenantId, id])
  // Asiento reversor de un cheque rechazado (Dr Deudores por Ventas / Cr
  // Caja [+ Cr gasto recuperado]) - ver AccountingService.
  // postCheckRejectionJournalEntry. Un cheque sólo tiene asiento propio
  // en el rechazo; su cobro/pago original ya quedó cubierto por el
  // receiptId/supplierPaymentId del Recibo/Pago que lo trajo o lo usó.
  checkId              String?             @unique
  check                Check?              @relation(fields: [tenantId, checkId], references: [tenantId, id])
  // Ajuste posteado al convertir una línea de extracto sin matchear en un
  // movimiento nuevo (Gasto/Ingreso bancario) - ver AccountingService.
  // postBankStatementAdjustmentJournalEntry. Una línea de extracto sólo
  // tiene asiento propio en este caso; una línea auto-matcheada o
  // vinculada a mano a una FinancialTransaction ya existente no genera
  // ninguno acá (esa transacción ya tenía o no el suyo).
  bankStatementLineId  String?             @unique
  bankStatementLine    BankStatementLine?  @relation(fields: [tenantId, bankStatementLineId], references: [tenantId, id])
  // Asiento neto del RECPAM de un período (Fase 2 del Ajuste por Inflación,
  // RT6/NC39) - ver InflationAdjustmentService.postInflationAdjustment. Un
  // período sólo tiene asiento propio acá; el desglose por cuenta monetaria
  // que armó el número es sólo informativo (vista previa), nunca se postea
  // línea por línea.
  inflationAdjustmentId String?              @unique
  inflationAdjustment   InflationAdjustment? @relation(fields: [tenantId, inflationAdjustmentId], references: [tenantId, id])
  // Asiento de ajuste por diferencia de arqueo al cerrar un turno de Caja
  // (Faltante/Sobrante) - ver AccountingService.postCashSessionAdjustmentJournalEntry.
  // Un turno sólo tiene asiento propio acá cuando cierra con diferencia
  // distinta de cero; un cierre exacto no genera ninguno.
  cashSessionId        String?              @unique
  cashSession          CashSession?         @relation(fields: [tenantId, cashSessionId], references: [tenantId, id])
  description          String
  date                 DateTime            @default(now())
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  reversalOfId         String?             @unique
  reversalOf           JournalEntry?       @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy           JournalEntry?       @relation("EntryReversal")

  lines JournalEntryLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId])
  @@unique([tenantId, creditNoteId])
  @@unique([tenantId, goodsReceiptId])
  @@unique([tenantId, supplierReturnId])
  @@unique([tenantId, purchaseInvoiceId])
  @@unique([tenantId, purchaseCreditNoteId])
  @@unique([tenantId, supplierPaymentId])
  @@unique([tenantId, receiptId])
  @@unique([tenantId, checkId])
  @@unique([tenantId, bankStatementLineId])
  @@unique([tenantId, inflationAdjustmentId])
  @@unique([tenantId, cashSessionId])
  @@index([tenantId])
  @@map("journal_entries")
}

// Un registro por período de Ajuste por Inflación ya emitido (RT6/NC39,
// Fase 2) - existe sólo para que el mismo rango exacto no se pueda postear
// dos veces (@@unique de abajo), mismo criterio que BankStatementImport
// contra re-importar el mismo archivo. El desglose por cuenta que dio este
// número vive únicamente en la vista previa (InflationAdjustmentService.
// getPreview, recalculable en cualquier momento) - no se persiste acá.
model InflationAdjustment {
  id              String       @id @default(uuid())
  tenantId        String
  periodFrom      DateTime
  periodTo        DateTime
  recpamAmount    Decimal      @db.Decimal(14, 2)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  journalEntry JournalEntry?

  @@unique([tenantId, id])
  @@unique([tenantId, periodFrom, periodTo])
  @@index([tenantId])
  @@map("inflation_adjustments")
}

// One line = one account + one direction + one amount (the standard
// double-entry shape) - NOT a debit account and a credit account on the
// same row, which can't express a compound entry (e.g. one debit split
// across several credit accounts of different amounts).
model JournalEntryLine {
  id             String               @id @default(uuid())
  tenantId       String
  journalEntryId String
  journalEntry   JournalEntry         @relation(fields: [tenantId, journalEntryId], references: [tenantId, id])
  accountId      String
  account        AccountingAccount    @relation(fields: [tenantId, accountId], references: [tenantId, id])
  direction      JournalLineDirection
  amount         Decimal              @db.Decimal(14, 2)

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@map("journal_entry_lines")
}

// Versioned by design: never edit `rate`/`formula` on a definition that's
// already been used by an issued invoice - close it with `validTo` and
// create a new row instead. That's what lets a tax change (IVA 21% ->
// 22%, a new IIBB rate) apply going forward without altering the frozen
// calculation on documents already issued.
model TaxDefinition {
  id                  String             @id @default(uuid())
  tenantId            String
  code                String
  name                String
  calculationType     TaxCalculationType @default(PERCENTAGE)
  rate                Decimal?           @db.Decimal(5, 2)
  fixedAmount         Decimal?           @db.Decimal(14, 2)
  formula             String?
  validFrom           DateTime           @default(now())
  validTo             DateTime?
  managedByAccountant Boolean            @default(false)

  articles Article[]

  @@unique([tenantId, code, validFrom])
  @@index([tenantId])
  @@map("tax_definitions")
}

enum WithholdingTaxType {
  INCOME_TAX
  VAT
  GROSS_INCOME
}

// The 24 Argentine fiscal jurisdictions (CABA + 23 provincias) - only
// meaningful on a GROSS_INCOME regime, since IIBB rates/minimums are set
// per-jurisdiction (Ganancias/IVA are national, jurisdiction is always
// null there). Not reused anywhere else in the schema (Company.
// fiscalAddress stays free text, see its own comment) - this enum exists
// purely to classify WithholdingRegime/SupplierPaymentWithholding rows.
enum ArgentineJurisdiction {
  CABA
  BUENOS_AIRES
  CATAMARCA
  CHACO
  CHUBUT
  CORDOBA
  CORRIENTES
  ENTRE_RIOS
  FORMOSA
  JUJUY
  LA_PAMPA
  LA_RIOJA
  MENDOZA
  MISIONES
  NEUQUEN
  RIO_NEGRO
  SALTA
  SAN_JUAN
  SAN_LUIS
  SANTA_CRUZ
  SANTA_FE
  SANTIAGO_DEL_ESTERO
  TIERRA_DEL_FUEGO
  TUCUMAN
}

// Retenciones que EL TENANT practica a sus proveedores (Ganancias/IVA/IIBB)
// al pagarles - dirección opuesta a Company.withholdsVat/withholdsIncomeTax/
// withholdsGrossIncome (esos son sobre cuando un CLIENTE nos retiene a
// nosotros, lado Cuentas a Cobrar, todavía sin lógica). Catálogo versionado
// igual que TaxDefinition arriba (mismo motivo: no se puede editar la tasa
// de un régimen ya usado en un pago existente, hay que cerrar con validTo y
// crear una fila nueva) - ver WithholdingRegimeService.reviseRegime, mismo
// patrón que TaxesService.reviseTaxDefinition. rate/minTaxableAmount son
// las tasas/mínimos reales de AFIP/ARBA/etc. que el contador tipea a mano;
// el sistema no persigue la tabla oficial de cada jurisdicción (24
// jurisdicciones, tablas que cambian con el tiempo) - mismo criterio que
// AFIP WSFE quedó stub por ahora (ver RealAfipPadronService vs. CAE falso).
model WithholdingRegime {
  id       String @id @default(uuid())
  tenantId String
  code     String
  name     String

  taxType      WithholdingTaxType
  // Sólo se espera valor si taxType = GROSS_INCOME - no hay constraint a
  // nivel DB forzándolo (mismo nivel de confianza que el resto de este
  // catálogo, delegado al contador que lo configura).
  jurisdiction ArgentineJurisdiction?

  rate             Decimal @db.Decimal(5, 2)
  // Mínimo no imponible: por debajo de esta base, no corresponde retener.
  // 0 = siempre retiene (algunos regímenes no tienen piso).
  minTaxableAmount Decimal @default(0) @db.Decimal(14, 2)

  validFrom           DateTime  @default(now())
  validTo             DateTime?
  managedByAccountant Boolean   @default(false)

  withholdingLines SupplierPaymentWithholding[]

  @@unique([tenantId, code, validFrom])
  @@index([tenantId, taxType])
  @@map("withholding_regimes")
}

enum TaxDeadlineKind {
  IVA
  MONOTRIBUTO
  IIBB
  GANANCIAS
  OTRO
}

enum TaxDeadlineStatus {
  PENDING
  DONE
}

// Entidad chica a propósito, sin motor de recurrencia ni integración con
// ningún calendario oficial de ARCA - carga 100% manual, igual criterio que
// TaxDefinition/WithholdingRegime arriba (data mantenida a mano por el
// contador, no calculada). Ver docs/plan_modulo_contadores.txt, punto 5 -
// el consolidado de MembershipsService.getPortfolio() suma "próximos N
// vencimientos" por tenant leyendo esta tabla dentro del mismo loop.
model TaxDeadline {
  id              String            @id @default(uuid())
  tenantId        String
  kind            TaxDeadlineKind
  dueDate         DateTime
  description     String
  status          TaxDeadlineStatus @default(PENDING)
  createdByUserId String
  createdAt       DateTime          @default(now())

  @@index([tenantId, status, dueDate])
  @@map("tax_deadlines")
}

// Retención puntual aplicada a un SupplierPayment - análogo a
// PurchaseInvoiceTaxLine pero del lado del pago (ver AccountingService.
// postSupplierPaymentJournalEntry, que la lee agrupada por taxType).
// taxType/jurisdiction/concept son un snapshot (no leen del regime en
// runtime) - un pago ya registrado no puede cambiar de significado si el
// régimen se edita/desactiva después, mismo criterio que
// PurchaseInvoice.supplierName/supplierTaxId congelan el dato del
// proveedor al momento de facturar.
model SupplierPaymentWithholding {
  id                String          @id @default(uuid())
  tenantId          String
  supplierPaymentId String
  supplierPayment   SupplierPayment @relation(fields: [tenantId, supplierPaymentId], references: [tenantId, id])

  // Null si se tipeó a mano sin elegir un régimen del catálogo - igual que
  // PurchaseInvoiceTaxLine no exige un TaxDefinition detrás.
  regimeId String?
  regime   WithholdingRegime? @relation(fields: [regimeId], references: [id])

  taxType      WithholdingTaxType
  jurisdiction ArgentineJurisdiction?
  concept      String
  amount       Decimal                @db.Decimal(14, 2)

  // Nº de certificado de retención entregado al proveedor (comprobante que
  // AFIP/ARBA exige emitir) - texto libre, opcional; no hay generación de
  // PDF/numeración propia para esto todavía.
  certificateNumber String?

  @@index([tenantId, supplierPaymentId])
  @@map("supplier_payment_withholdings")
}

model FinancialAccount {
  id             String                   @id @default(uuid())
  tenantId       String
  name           String
  provider       FinancialAccountProvider
  currentBalance Decimal                  @default(0) @db.Decimal(14, 2)

  receipts         Receipt[]
  transactions     FinancialTransaction[]
  supplierPayments SupplierPayment[]
  // Cheques depositados/emitidos contra esta cuenta - ver model Check.
  checks           Check[]
  // Conciliación bancaria - ver models BankStatementImport/BankStatementLine.
  bankStatementImports BankStatementImport[]
  bankStatementLines   BankStatementLine[]
  // El "cajón" de una caja de mostrador es una FinancialAccount 1:1 (ver
  // CashRegister.financialAccountId) - relación inversa opcional, la
  // mayoría de las cuentas financieras no son cajas de POS.
  cashRegister         CashRegister?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("financial_accounts")
}

model FinancialTransaction {
  id                 String           @id @default(uuid())
  tenantId           String
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  amount             Decimal          @db.Decimal(14, 2)
  reconciled         Boolean          @default(false)
  externalRef        String?
  occurredAt         DateTime         @default(now())

  // Seteado si esta transacción fue creada, o vinculada a mano, a partir
  // de una línea de un extracto bancario importado - ver
  // BankStatementLine.matchedTransactionId.
  bankStatementLine  BankStatementLine?

  @@index([tenantId])
  @@map("financial_transactions")
}

// --- Conciliación Bancaria (@plexo/bank-reconciliation) ---
// Fase 1: sólo plantilla propia de Oplex (Fecha/Descripción/Importe), sin
// parser nativo por banco real todavía (necesita un archivo de muestra real
// antes de codearse - mismo criterio ya aplicado a AFIP QR/Tiendanube).

enum BankStatementLineStatus {
  PENDING
  MATCHED
  IGNORED
}

model BankStatementImport {
  id                 String              @id @default(uuid())
  tenantId           String
  financialAccountId String
  financialAccount   FinancialAccount    @relation(fields: [financialAccountId], references: [id])
  fileName           String
  // sha256 del buffer subido - guarda contra re-importar el mismo archivo
  // dos veces (no hay un ID externo por línea que dedupear, como en un
  // webhook, así que se dedupea el archivo entero).
  fileHash           String
  lineCount          Int
  createdByUserId    String
  createdBy          User                @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime            @default(now())

  lines BankStatementLine[]

  @@unique([tenantId, financialAccountId, fileHash])
  @@index([tenantId])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id                     String                  @id @default(uuid())
  tenantId               String
  bankStatementImportId  String
  bankStatementImport    BankStatementImport     @relation(fields: [bankStatementImportId], references: [id])
  financialAccountId     String
  financialAccount       FinancialAccount        @relation(fields: [financialAccountId], references: [id])

  lineDate    DateTime
  description String
  // Misma convención de signo que FinancialTransaction.amount (positivo =
  // ingreso, negativo = egreso) - la columna "Importe" de la plantilla la
  // garantiza, sin conversión de signo en ningún lado del código.
  amount      Decimal                 @db.Decimal(14, 2)
  status      BankStatementLineStatus @default(PENDING)

  // Seteado al hacer match automático, vincular a mano, o al crear un
  // movimiento nuevo (Gasto/Ingreso bancario) a partir de esta línea.
  matchedTransactionId String?               @unique
  matchedTransaction   FinancialTransaction? @relation(fields: [matchedTransactionId], references: [id])

  createdAt DateTime @default(now())

  // Sólo existe cuando la línea se convirtió en un movimiento nuevo (Gasto/
  // Ingreso bancario) - ver AccountingService.postBankStatementAdjustmentJournalEntry.
  // Una línea auto-matcheada o vinculada a mano a una transacción ya
  // existente no genera ninguno acá (esa transacción ya tenía o no el suyo).
  journalEntry JournalEntry?

  // @@unique([tenantId, id]) existe sólo para que
  // JournalEntry.bankStatementLineId use el mismo FK compuesto que checkId.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, financialAccountId, status])
  @@map("bank_statement_lines")
}

// --- Tesorería / Cartera de Cheques (@plexo/treasury) ---

enum CheckKind {
  THIRD_PARTY
  OWN
}

enum CheckFormat {
  PHYSICAL
  ECHEQ
}

// Un solo enum para los dos ciclos de vida (no uno condicional por kind -
// Prisma no soporta enums parametrizados): PORTFOLIO/DEPOSITED/ENDORSED/
// CLEARED/REJECTED son sólo válidos para THIRD_PARTY, ISSUED/CLEARED/
// VOIDED sólo para OWN. CheckService.ts es quien valida qué transición es
// legal para cada kind - ver el comentario en model Check.
enum CheckStatus {
  PORTFOLIO
  DEPOSITED
  ENDORSED
  CLEARED
  REJECTED
  ISSUED
  VOIDED
}

/**
 * Cheque de tercero (recibido de un cliente, vía Receipt) o propio (emitido
 * para pagarle a un proveedor, vía SupplierPayment). Sigue el mismo
 * criterio de FK que el resto de los documentos fiscales/financieros de
 * este schema: compuesta (tenantId, xId) hacia Receipt/SupplierPayment/
 * JournalEntry (documentos), simple hacia FinancialAccount/Company
 * (catálogos) - mismo precedente que Receipt.financialAccountId/
 * SupplierPayment.financialAccountId ya usan.
 * receiptId/supplierPaymentId son @unique (1 cheque como mucho por
 * Recibo/Pago, no una lista) porque ambos documentos ya modelan "un solo
 * monto/método por fila" (Receipt.amount, SupplierPayment.amount) - pagar
 * con 2 cheques a la vez son 2 Receipt/SupplierPayment separados, cada uno
 * con su propio Check.
 */
model Check {
  id       String      @id @default(uuid())
  tenantId String
  kind     CheckKind
  format   CheckFormat @default(PHYSICAL)

  number     String
  bankName   String
  // CUIT de quien firmó el cheque - el cliente para THIRD_PARTY, null para
  // OWN (es el propio tenant, ya identificado por el tenant mismo).
  drawerCuit String?

  amount    Decimal  @db.Decimal(14, 2)
  issueDate DateTime
  dueDate   DateTime

  status CheckStatus

  // Snapshot (mismo criterio que PurchaseInvoice.supplierName) - evita un
  // join Check->Receipt->Invoice->Company (o el equivalente de Compras)
  // sólo para mostrar/filtrar por cliente o proveedor en la grilla de
  // Cartera de Cheques.
  customerId String?
  customer   Company? @relation("CheckCustomer", fields: [customerId], references: [id])
  supplierId String?
  supplier   Company? @relation("CheckSupplier", fields: [supplierId], references: [id])

  // Tercero: el Recibo que lo trajo a cartera (status inicial PORTFOLIO).
  receiptId          String?
  receipt            Receipt?          @relation(fields: [tenantId, receiptId], references: [tenantId, id])
  // Tercero endosado a un proveedor, o el Pago que se canceló emitiendo
  // este cheque propio - el "destino" del cheque.
  supplierPaymentId  String?
  supplierPayment    SupplierPayment?  @relation(fields: [tenantId, supplierPaymentId], references: [tenantId, id])
  // Depositado (tercero) o emitido contra (propio) esta cuenta propia -
  // null mientras un tercero sigue físicamente en cartera sin depositar.
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])

  rejectionReason    String?
  rejectionFeeAmount Decimal?  @db.Decimal(14, 2)
  rejectedAt         DateTime?

  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  // Sólo se postea en el rechazo (ver AccountingService.
  // postCheckRejectionJournalEntry) - el cobro/pago original ya tiene su
  // propio asiento vía JournalEntry.receiptId/supplierPaymentId.
  journalEntry JournalEntry?

  @@unique([tenantId, id])
  @@unique([tenantId, receiptId])
  @@unique([tenantId, supplierPaymentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("checks")
}

// --- Compras (@plexo/purchases) ---
//
// Two related documents: QuoteRequest ("Pedido de Cotización", an internal
// working draft - build/clone/tweak lines before deciding) converts into a
// PurchaseOrder ("Orden de Compra", the document actually sent to the
// supplier). Deliberately unrelated to the pre-existing `Quote`/`QuoteLine`
// models above (a never-implemented Nx stub for sales-side presupuestos,
// see libs/modules/quotes) - different concept, different lib, different
// names on purpose so the two don't get confused.

enum PurchaseDocumentStatus {
  DRAFT
  // QuoteRequest only: converted into a PurchaseOrder via
  // QuoteRequestService.convert(). Terminal - a converted request is never
  // edited again, see its own PurchaseOrder for what happens next.
  CONVERTED
  // PurchaseOrder only: sentAt/sentVia record how (see below).
  SENT
  CANCELLED
}

enum PurchaseSendChannel {
  EMAIL
  // Sent via a wa.me deep link the user opened and confirmed - there's no
  // delivery receipt for this, "sent" here means "the user told us they
  // sent it", not a verified read/delivery status.
  WHATSAPP
}

// 5 visual templates for the QuoteRequest/PurchaseOrder PDF (see
// libs/modules/purchases/src/lib/pdf) - a user-level default, overridable
// per-download without persisting (see PurchasesPreferencesController).
enum PdfStyle {
  MODERNO
  COMPACTO
  TRADICIONAL
  NATURAL
  LETRAS_GRANDES
}

// Tamaño de papel para el PDF de Facturación (ver User.invoicePdfFormat) -
// A4 y A5 comparten el mismo layout fiel a ARCA (sólo cambia el tamaño de
// hoja), TICKET es un layout angosto de una columna para impresora
// térmica/de tickets común. Ninguno es integración con un Controlador
// Fiscal real (eso seguiría siendo Factura Electrónica vía WSFE, sólo
// cambia el tamaño de papel del PDF resultante).
enum InvoicePdfFormat {
  A4
  A5
  TICKET
}

// Free-text catalogs the tenant maintains itself (transporte/forma de
// pago/plazo de entrega) - same shape all three, kept as separate tables
// (not one polymorphic table) since each is referenced by its own FK
// column on QuoteRequest/PurchaseOrder, but served by one generic
// PurchaseCatalogsService parametrized by model name (same idiom already
// used by @AuditEntity/UserActivityLog.entityType elsewhere in the repo).
// `active` (not hard delete) for the same reason as Company.active: a
// past document that used "Flete propio" keeps showing it even after
// someone deactivates the option.
model TransportMode {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  active   Boolean @default(true)

  quoteRequests  QuoteRequest[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("transport_modes")
}

model PaymentTerm {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  active   Boolean @default(true)

  quoteRequests  QuoteRequest[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("payment_terms")
}

model DeliveryTime {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  active   Boolean @default(true)

  quoteRequests  QuoteRequest[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("delivery_times")
}

model QuoteRequest {
  id         String                 @id @default(uuid())
  tenantId   String
  // "{createdBy.quoteRequestPrefix}-{n padded to 6}" - assigned once at
  // creation from the creating user's own series (see User fields above),
  // never renumbered afterward (matches Invoice.number's frozen-at-issuance
  // precedent).
  number     String
  supplierId String
  supplier   Company                @relation(fields: [supplierId], references: [id])
  status     PurchaseDocumentStatus @default(DRAFT)
  currencyId String
  currency   Currency               @relation(fields: [currencyId], references: [id])

  transportModeId String?
  transportMode   TransportMode? @relation(fields: [transportModeId], references: [id])
  paymentTermId   String?
  paymentTerm     PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  deliveryTimeId  String?
  deliveryTime    DeliveryTime?  @relation(fields: [deliveryTimeId], references: [id])

  validUntil     DateTime?
  notes          String?
  // Cached sum of quantity*estimatedUnitCost - null if any line is missing
  // a cost estimate (there's nothing meaningful to sum in that case).
  estimatedTotal Decimal?  @db.Decimal(14, 2)

  // Shared tag across N QuoteRequest rows (one per supplier) created
  // together via QuoteRequestService.createGroup, to compare quotes for the
  // same purchase need. Null for a QuoteRequest created the regular
  // single-supplier way - grouping is opt-in, not the default. No parent
  // table on purpose (see QuoteRequestService.compareGroup/selectWinner) -
  // this is just a label, not a new document type.
  rfqGroupId String?

  // True sólo para los que crea InventoryReplenishmentSchedulerService sin
  // intervención humana (ver MinimumStock.autoReplenish) - atribuidos al
  // OWNER del tenant, así que esto es lo único que los distingue de uno
  // que ese mismo OWNER haya creado a mano. Usado también para no crear
  // más de uno por proveedor por día (ver el scheduler).
  autoGenerated Boolean @default(false)

  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  lines          QuoteRequestLine[]
  // Normally exactly one (see QuoteRequestService.convert) - kept to-many
  // so a CANCELLED conversion attempt never blocks trying again.
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@index([tenantId, rfqGroupId])
  @@map("quote_requests")
}

model QuoteRequestLine {
  id                String         @id @default(uuid())
  tenantId          String
  quoteRequestId    String
  quoteRequest      QuoteRequest   @relation(fields: [quoteRequestId], references: [id])
  articleVariantId  String
  articleVariant    ArticleVariant @relation(fields: [articleVariantId], references: [id])
  quantity          Decimal        @db.Decimal(14, 3)
  estimatedUnitCost Decimal?       @db.Decimal(14, 2)
  notes             String?

  @@index([tenantId])
  @@map("quote_request_lines")
}

model PurchaseOrder {
  id             String                 @id @default(uuid())
  tenantId       String
  // "{createdBy.purchaseOrderPrefix}-{n padded to 6}", same frozen-at-
  // creation rule as QuoteRequest.number.
  number         String
  supplierId     String
  supplier       Company                @relation(fields: [supplierId], references: [id])
  // Set when this order was born from QuoteRequestService.convert(); null
  // for orders created directly (no RFQ step).
  quoteRequestId String?
  quoteRequest   QuoteRequest?          @relation(fields: [quoteRequestId], references: [id])
  status         PurchaseDocumentStatus @default(DRAFT)
  currencyId     String
  currency       Currency               @relation(fields: [currencyId], references: [id])

  transportModeId String?
  transportMode   TransportMode? @relation(fields: [transportModeId], references: [id])
  paymentTermId   String?
  paymentTerm     PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  deliveryTimeId  String?
  deliveryTime    DeliveryTime?  @relation(fields: [deliveryTimeId], references: [id])

  notes String?
  // Sum of quantity*unitCost - always set (unlike QuoteRequest.
  // estimatedTotal), a PurchaseOrder line always has a real unitCost.
  total Decimal @db.Decimal(14, 2)

  // Both null until PurchaseOrderService.sendEmail()/markSentWhatsapp()
  // runs - "solo guardar" in the send dialog leaves the order DRAFT with
  // both still null.
  sentAt                 DateTime?
  sentVia                PurchaseSendChannel?
  // Snapshot of who actually got the last send - sentToEmail for EMAIL
  // (always the supplier's email at that moment, see sendEmail()),
  // sentToPhone/sentToContactName for WHATSAPP (the contact picked in
  // SendPurchaseOrderDialog, since Company.people has no "primary" contact
  // and WhatsApp has no delivery receipt to confirm any of this after the
  // fact). Denormalized on purpose, same reasoning as everywhere else in
  // this schema that snapshots a name at the time of the event: the
  // Person/email on file can change or the contact can be deleted later,
  // but this order was sent to whoever/whatever it actually was sent to.
  // Orders sent before this field existed keep these null - shown as "no
  // registrado" in the UI, not backfilled.
  sentToEmail            String?
  sentToPhone            String?
  sentToContactName      String?
  // Same snapshot-at-send-time reasoning as sentToContactName above -
  // copies Person.avatarUrl at the moment of the WhatsApp send (whatever
  // it was then, whether uploaded to /uploads/people or a pasted URL).
  // Null for EMAIL sends and for WhatsApp sends before this field existed.
  sentToContactAvatarUrl String?

  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  lines               PurchaseOrderLine[]
  // Cost history entries (PriceHistory.purchaseOrderId) recorded when a
  // PURCHASE_IN stock movement referenced this order - see
  // InventoryService.recordMovement.
  priceHistoryEntries PriceHistory[]
  // Remitos (goods receipts) recorded against this order - see
  // GoodsReceiptService. Zero, one, or many (partial deliveries).
  receipts            GoodsReceipt[]
  // Facturas de Compra recorded against this order - see
  // PurchaseInvoiceService. Zero (still awaiting invoicing, or a cancelled
  // order) to many (one per supplier invoice, since a single order can be
  // invoiced across several documents as receipts come in).
  invoices            PurchaseInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String         @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  articleVariantId String
  articleVariant   ArticleVariant @relation(fields: [articleVariantId], references: [id])
  quantity         Decimal        @db.Decimal(14, 3)
  unitCost         Decimal        @db.Decimal(14, 2)
  notes            String?

  goodsReceiptLines GoodsReceiptLine[]

  @@index([tenantId])
  @@map("purchase_order_lines")
}

// A single delivery event against a PurchaseOrder - "remito" in Argentine
// terminology. Quantity-only per line on purpose: a supplier's delivery
// note never carries price, the cost already lives on PurchaseOrderLine.
// unitCost (see GoodsReceiptService, which reads it instead of asking the
// user again). One warehouse per receipt - a delivery physically arrives
// at one location; a supplier splitting a delivery across warehouses is
// two receipts, not one with per-line warehouses.
model GoodsReceipt {
  id                String        @id @default(uuid())
  tenantId          String
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId       String
  warehouse         Warehouse     @relation(fields: [warehouseId], references: [id])
  // Free text - the supplier's own remito/comprobante number, not a Plexo-
  // generated series (unlike QuoteRequest.number/PurchaseOrder.number).
  supplierDocNumber String?
  // Photo or scan of the supplier's remito - same pattern as
  // Article.imageUrl/ArticleImageService (uploads/, served unauthenticated
  // via @fastify/static's generic /uploads/ prefix), but also allows PDF
  // (a remito is commonly scanned as one, not just photographed).
  attachmentUrl     String?
  receivedAt        DateTime      @default(now())
  notes             String?
  receivedByUserId  String
  receivedBy        User          @relation(fields: [receivedByUserId], references: [id])
  createdAt         DateTime      @default(now())

  lines        GoodsReceiptLine[]
  returns      SupplierReturn[]
  // The GRNI accrual entry posted when this receipt was recorded (Dr
  // Mercaderías / Cr Mercadería Recibida No Facturada) - see
  // AccountingService.postGoodsReceiptAccrual, called from
  // apps/api's GoodsReceiptsService right after GoodsReceiptService.create.
  journalEntry JournalEntry?
  // Which PurchaseInvoice(s) cleared this receipt's GRNI accrual - v1 is
  // whole-receipt only (see PurchaseInvoiceReceipt's own @@unique), so this
  // is 0 or 1 in practice, kept to-many for the same reason GoodsReceipt.
  // returns is to-many: never blocks a re-attempt.
  invoiceLinks PurchaseInvoiceReceipt[]

  @@unique([tenantId, id])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String            @id @default(uuid())
  tenantId            String
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  quantity            Decimal           @db.Decimal(14, 3)

  stockMovements      StockMovement[]
  supplierReturnLines SupplierReturnLine[]

  @@index([tenantId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

// Goods sent back to the supplier out of a specific remito (e.g. a
// defective unit) - always scoped to one GoodsReceipt, same reasoning as
// GoodsReceipt itself being scoped to one warehouse: no depósito/receipt
// picker here, it's implied by which remito the returned line belongs to.
// Reopens "pending" on the PurchaseOrder line it traces back to (see
// GoodsReceiptService.getReceivedQuantitiesByLine, which nets returns out
// of received) - a supplier owing replacement units shows up the same way
// a partial delivery does.
model SupplierReturn {
  id               String       @id @default(uuid())
  tenantId         String
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  // Why it's being returned - required, same criterion as CreditNote.reason.
  reason           String
  notes            String?
  returnedByUserId String
  returnedBy       User         @relation(fields: [returnedByUserId], references: [id])
  createdAt        DateTime     @default(now())

  lines               SupplierReturnLine[]
  // The GRNI reversal entry posted when this return was recorded (Dr
  // Mercadería Recibida No Facturada / Cr Mercaderías, proportional to the
  // returned quantity) - see AccountingService.reverseSupplierReturnAccrual.
  journalEntry        JournalEntry?
  // Credit note(s) the supplier issued that happen to reference this
  // physical return - purely for traceability, see PurchaseCreditNote's
  // own comment on why this isn't @unique.
  purchaseCreditNotes PurchaseCreditNote[]

  @@unique([tenantId, id])
  @@index([tenantId, goodsReceiptId])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id                 String           @id @default(uuid())
  tenantId           String
  supplierReturnId   String
  supplierReturn     SupplierReturn   @relation(fields: [supplierReturnId], references: [id])
  goodsReceiptLineId String
  goodsReceiptLine   GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id])
  quantity           Decimal          @db.Decimal(14, 3)

  @@index([tenantId])
  @@index([goodsReceiptLineId])
  @@map("supplier_return_lines")
}

// --- Cuentas a Pagar (@plexo/purchases + @plexo/payables) ---
//
// Factura de Compra: the supplier's own fiscal document, always tied to a
// PurchaseOrder (that's where the article-level detail/cost already lives -
// see PurchaseOrderLine.unitCost). Deliberately header-level, not
// line-by-line like Invoice/InvoiceLine: the user is transcribing totals
// off a piece of paper the supplier already priced and taxed, not
// recalculating per-article pricing again (that's what makes entry fast -
// see PurchaseInvoiceService). Zero or more GoodsReceipts can be linked
// (PurchaseInvoiceReceipt) to clear their GRNI accrual; zero is valid for a
// pure-services PurchaseOrder (Article.isService never gets a remito).
enum PurchaseInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PurchaseInvoiceTaxLineType {
  IVA_CREDITO
  PERCEPCION
}

model PurchaseInvoice {
  id                    String                @id @default(uuid())
  tenantId              String
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  supplierId            String
  supplier              Company               @relation(fields: [supplierId], references: [id])
  // Snapshot at entry time - same reasoning as Invoice.customerName/
  // customerTaxId: Company.name/taxId can change later, this record
  // (backing an IVA Crédito claim) must not silently change with it.
  supplierName          String
  supplierTaxId         String?
  // The supplier's own invoice number/date - free text, NOT a Plexo-
  // generated series (same convention as GoodsReceipt.supplierDocNumber;
  // unlike QuoteRequest.number/PurchaseOrder.number, Plexo isn't the one
  // issuing this document).
  supplierInvoiceNumber String
  // Punto de Venta/Número/letra estructurados del comprobante del
  // proveedor - opcionales, sólo para el export Libro de IVA Digital (RG
  // 4597, ver CitiExportService en @plexo/taxes). No reemplazan
  // supplierInvoiceNumber (que sigue siendo el texto libre de siempre) -
  // sin backfill, comprobantes cargados sin esto quedan afuera del
  // export en vez de inventar un código de comprobante ARCA incorrecto.
  documentLetter        DocumentLetter?
  pointOfSale           String?
  number                String?
  supplierInvoiceDate   DateTime
  // Optional on purpose, same convention as Invoice.dueDate: PurchaseOrder.
  // paymentTermId today is just a free-text label ("30 días", "Contado"),
  // not a structured day-count Plexo could compute this from - the user
  // fills it in directly if they want this invoice to show up in the
  // Cuentas a Pagar aging report (PayablesService.getAgingReport, same
  // "no dueDate -> current" treatment as its AR counterpart).
  dueDate               DateTime?
  currencyId            String
  currency              Currency              @relation(fields: [currencyId], references: [id])
  // Net amount before tax, as written on the supplier's invoice.
  subtotal              Decimal               @db.Decimal(14, 2)
  // Sum of taxLines (IVA Crédito + Percepciones).
  taxTotal              Decimal               @db.Decimal(14, 2)
  total                 Decimal               @db.Decimal(14, 2)
  balanceDue            Decimal               @db.Decimal(14, 2)
  status                PurchaseInvoiceStatus @default(ISSUED)
  // Photo or scan of the supplier's invoice - same pattern as
  // GoodsReceipt.attachmentUrl.
  attachmentUrl         String?
  notes                 String?
  createdByUserId       String
  createdBy             User                  @relation(fields: [createdByUserId], references: [id])
  createdAt             DateTime              @default(now())

  taxLines     PurchaseInvoiceTaxLine[]
  receiptLinks PurchaseInvoiceReceipt[]
  payments     SupplierPayment[]
  creditNotes  PurchaseCreditNote[]
  journalEntry JournalEntry?

  @@unique([tenantId, id])
  @@index([tenantId, supplierId])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_invoices")
}

// One row per tax/perception line on the supplier's invoice - free-text
// concept (e.g. "IVA 21%", "Percepción IIBB CABA"), not tied to
// TaxDefinition (that catalog is for OUR sales-side tax rates, not
// whatever a given supplier happens to charge) or to a rigid regime
// catalog - same free-text criterion already used for
// Company.grossIncomeNumber/taxCondition. IVA_CREDITO and PERCEPCION both
// land in the same aggregate GL accounts (see AccountingService) - this
// table is the only place the per-concept detail is kept, same idiom as
// PriceHistory being the detail behind an aggregate StockLedger.avgUnitCost.
model PurchaseInvoiceTaxLine {
  id                String                     @id @default(uuid())
  tenantId          String
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice            @relation(fields: [tenantId, purchaseInvoiceId], references: [tenantId, id])
  type              PurchaseInvoiceTaxLineType
  concept           String
  amount            Decimal                    @db.Decimal(14, 2)
  // Alícuota + base imponible de esta fila - sólo se completan para
  // type: IVA_CREDITO (una Percepción no tiene una tasa de IVA propia).
  // Nullable a propósito: queda null en filas históricas (sin backfill,
  // ver PROGRESS.md punto 23) y en filas PERCEPCION - VatBookService cae
  // a "otras" cuando taxRate es null. Igual criterio que
  // InvoiceLine.taxRate del lado Ventas.
  netAmount         Decimal?                   @db.Decimal(14, 2)
  taxRate           Decimal?                   @db.Decimal(5, 2)
  // Sub-clasificación de una fila PERCEPCION (IVA/IIBB/Ganancias) para
  // rutearla a la columna correcta del export Libro de IVA Digital de
  // Compras - reusa el enum de SupplierPaymentWithholding.taxType, no se
  // crea uno nuevo. null (histórico o no elegido) cae en "otros
  // impuestos nacionales" en el export, no se pierde ni se inventa.
  taxType           WithholdingTaxType?

  @@index([tenantId])
  @@map("purchase_invoice_tax_lines")
}

// Which GoodsReceipt(s) this invoice clears from the GRNI bridge account.
// v1 is whole-receipt only (see PurchaseInvoiceService) - the @@unique
// below is what actually enforces that a receipt can't be invoiced twice,
// not just a UI convention.
model PurchaseInvoiceReceipt {
  id                String          @id @default(uuid())
  tenantId          String
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [tenantId, purchaseInvoiceId], references: [tenantId, id])
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt    @relation(fields: [tenantId, goodsReceiptId], references: [tenantId, id])

  @@unique([tenantId, goodsReceiptId])
  @@index([tenantId, purchaseInvoiceId])
  @@map("purchase_invoice_receipts")
}

// Nota de Crédito de Compra: a credit note the SUPPLIER issues to the
// tenant against an already-recorded PurchaseInvoice (discount, pricing
// correction, billing error) - NOT a physical return of goods, that's
// SupplierReturn (see its own comment). Header-level, same reasoning as
// PurchaseInvoice/PurchaseInvoiceTaxLine: the user is transcribing totals
// off a piece of paper the supplier already issued, not re-deriving
// article-level detail. supplierReturnId links it to a SupplierReturn when
// the credit note happens to correspond to one (traceability only,
// nullable and NOT unique - a supplier could issue more than one credit
// note against the same physical return, or none at all for a
// pricing-only correction with no goods movement).
enum PurchaseCreditNoteStatus {
  ISSUED
  CANCELLED
}

model PurchaseCreditNote {
  id                       String                   @id @default(uuid())
  tenantId                 String
  purchaseInvoiceId        String
  purchaseInvoice          PurchaseInvoice          @relation(fields: [tenantId, purchaseInvoiceId], references: [tenantId, id])
  supplierId               String
  supplier                 Company                  @relation(fields: [supplierId], references: [id])
  // Snapshot at entry time, taken from the PurchaseInvoice being credited -
  // same reasoning as PurchaseInvoice.supplierName/supplierTaxId themselves.
  supplierName             String
  supplierTaxId            String?
  // The supplier's own credit note number/date - free text, NOT a Plexo-
  // generated series, same convention as PurchaseInvoice.supplierInvoiceNumber.
  supplierCreditNoteNumber String
  // Ver el mismo comentario en PurchaseInvoice - aditivo, sólo para el
  // export Libro de IVA Digital.
  documentLetter           DocumentLetter?
  pointOfSale              String?
  number                   String?
  supplierCreditNoteDate   DateTime
  reason                   String
  currencyId               String
  currency                 Currency                 @relation(fields: [currencyId], references: [id])
  subtotal                 Decimal                  @db.Decimal(14, 2)
  taxTotal                 Decimal                  @db.Decimal(14, 2)
  total                    Decimal                  @db.Decimal(14, 2)
  status                   PurchaseCreditNoteStatus @default(ISSUED)
  // Optional, not unique - see comment above the enum.
  supplierReturnId         String?
  supplierReturn           SupplierReturn?          @relation(fields: [tenantId, supplierReturnId], references: [tenantId, id])
  // Photo or scan of the supplier's credit note - same pattern as
  // PurchaseInvoice.attachmentUrl.
  attachmentUrl            String?
  notes                    String?
  createdByUserId          String
  createdBy                User                     @relation(fields: [createdByUserId], references: [id])
  createdAt                DateTime                 @default(now())

  taxLines     PurchaseCreditNoteTaxLine[]
  journalEntry JournalEntry?

  @@unique([tenantId, id])
  @@index([tenantId, purchaseInvoiceId])
  @@index([tenantId, supplierId])
  @@index([tenantId, supplierReturnId])
  @@map("purchase_credit_notes")
}

// One row per tax/perception line on the supplier's credit note - same
// free-text-concept, aggregate-GL-account criterion as PurchaseInvoiceTaxLine,
// whose type enum this reuses as-is rather than duplicating it.
model PurchaseCreditNoteTaxLine {
  id                   String                     @id @default(uuid())
  tenantId             String
  purchaseCreditNoteId String
  purchaseCreditNote   PurchaseCreditNote         @relation(fields: [tenantId, purchaseCreditNoteId], references: [tenantId, id])
  type                 PurchaseInvoiceTaxLineType
  concept              String
  amount               Decimal                    @db.Decimal(14, 2)
  // Same fields, same nullability criterion as PurchaseInvoiceTaxLine.
  netAmount            Decimal?                   @db.Decimal(14, 2)
  taxRate              Decimal?                   @db.Decimal(5, 2)
  taxType              WithholdingTaxType?

  @@index([tenantId])
  @@map("purchase_credit_note_tax_lines")
}

// A payment made against a PurchaseInvoice - mirrors Receipt (the AR
// equivalent) field-for-field, including the same shallow
// FinancialAccount integration (no automatic currentBalance update there
// either - see Receipt). Unlike Receipt, this DOES post a journal entry
// (Dr Proveedores / Cr Caja) - see AccountingService.
// postSupplierPaymentJournalEntry and the decision note on
// InvoicingService.recordReceipt's own gap, tracked separately.
model SupplierPayment {
  id                 String            @id @default(uuid())
  tenantId           String
  purchaseInvoiceId  String
  purchaseInvoice    PurchaseInvoice   @relation(fields: [tenantId, purchaseInvoiceId], references: [tenantId, id])
  amount             Decimal           @db.Decimal(14, 2)
  method             String
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  paidAt             DateTime          @default(now())
  recordedByUserId   String
  recordedBy         User              @relation(fields: [recordedByUserId], references: [id])

  journalEntry JournalEntry?
  withholdings SupplierPaymentWithholding[]
  // El cheque (de tercero endosado, o propio emitido) que canceló este
  // pago, si no fue en efectivo/transferencia - ver model Check.
  check        Check?

  @@unique([tenantId, id])
  @@index([tenantId, purchaseInvoiceId])
  @@map("supplier_payments")
}

enum ConnectorProvider {
  MERCADO_PAGO
  TIENDANUBE    // reservado para futuro (ver PLAN_MERCADOPAGO.md)
  MERCADO_LIBRE // reservado para futuro
}

enum ConnectorStatus {
  PENDING      // se inició OAuth, falta el callback
  CONNECTED    // activo y usable
  EXPIRED      // el token venció y no se pudo refrescar
  REVOKED      // el vendedor desautorizó desde el proveedor
  ERROR        // fallo repetido
  DISCONNECTED // el usuario lo desconectó desde OPLEX
}

// Conexión de un tenant con un proveedor externo (Mercado Pago hoy;
// Tiendanube/ML después, mismo patrón - ver @plexo/connectors). Sólo estado
// y metadata NO sensible - las credenciales en sí nunca viven acá, ver
// ConnectorSecret.
model Connector {
  id       String            @id @default(uuid())
  tenantId String
  provider ConnectorProvider
  status   ConnectorStatus   @default(PENDING)

  // Identidad de la cuenta externa, para mostrar en UI - no es secreto.
  externalAccountId String?
  externalNickname   String?
  scopes             String?

  connectedByUserId String?
  connectedAt       DateTime?
  lastRefreshAt     DateTime?
  lastErrorAt       DateTime?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secrets        ConnectorSecret[]
  paymentIntents PaymentIntent[]

  @@unique([tenantId, provider])
  @@unique([tenantId, id])
  @@index([tenantId, provider, status])
  @@map("connectors")
}

// Credencial cifrada de un Connector (access_token/refresh_token/
// webhook_secret, etc.), una fila por (connector, key). `value` es el mismo
// blob opaco base64 que produce EncryptionService.encrypt() (AES-256-GCM) -
// idéntico mecanismo que TenantSettings.afipCertEncrypted/afipKeyEncrypted,
// nunca texto plano. `tenantId` denormalizado (no sólo vía join a
// Connector) para que la policy RLS de abajo sea directa. onDelete: Cascade
// a propósito - borrar un Connector no debe dejar secretos huérfanos
// (ConnectorService.disconnect ya los borra a mano antes, esto es la red
// de seguridad para cualquier otro camino de borrado).
model ConnectorSecret {
  id          String    @id @default(uuid())
  tenantId    String
  connectorId String
  connector   Connector @relation(fields: [tenantId, connectorId], references: [tenantId, id], onDelete: Cascade)

  key   String
  value String

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectorId, key])
  @@index([tenantId])
  @@map("connector_secrets")
}

enum PaymentIntentStatus {
  PENDING   // link creado, esperando pago
  PAID      // pagado y conciliado (Fase 4)
  EXPIRED   // venció sin pagarse
  CANCELLED // anulado por el usuario
  REFUNDED
  ERROR
}

// Un cobro Mercado Pago pendiente contra una Factura o Cotización (ver
// MercadoPagoPaymentService, @plexo/mercadopago) - documentType/documentId
// es una referencia polimórfica a propósito (String simple, no FK real):
// Prisma no modela FKs condicionales, y esto puede apuntar a "invoices" o
// "quotes" según el caso. Sólo los intents de tipo INVOICE se concilian
// automáticamente en la Fase 4 (vía SalesService.recordReceipt, que exige
// un invoiceId) - Quote no tiene ningún concepto de saldo/pago en este
// schema (es un presupuesto, no un documento fiscal), así que un intent de
// tipo QUOTE queda como registro informativo: cuando se paga, se marca PAID
// acá pero no dispara ningún asiento contable ni actualiza la Cotización.
model PaymentIntent {
  id          String            @id @default(uuid())
  tenantId    String
  connectorId String
  connector   Connector         @relation(fields: [tenantId, connectorId], references: [tenantId, id])

  documentType String // "INVOICE" | "QUOTE"
  documentId   String

  provider ConnectorProvider @default(MERCADO_PAGO)

  // Lo que devuelve MP al crear la preferencia (Checkout Pro).
  externalId   String? // preference_id
  initPoint    String? // URL de pago (link)
  qrCodeBase64 String? // data URI PNG del QR (ver mercadopago-qr.util.ts) - mismo formato que buildAfipQrDataUri

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("ARS")

  status PaymentIntentStatus @default(PENDING)

  // Trazabilidad del pago real cuando llega (Fase 4).
  externalPaymentId String? // payment id de MP
  paidAt            DateTime?
  paymentRaw        Json? // payload crudo del pago, para auditoría

  // Idempotencia de creación: un UUID fresco por intent, enviado como
  // X-Idempotency-Key a MP - la deduplicación real de "no crear dos
  // preferencias para el mismo documento" pasa por buscar un PENDING
  // existente ANTES de llegar acá (MercadoPagoPaymentService.
  // createPaymentLink), no por derivar esta clave de (documentId+amount) -
  // eso rompería al reintentar cobrar el mismo documento después de que el
  // intent anterior expiró/se canceló, con la misma FK única.
  idempotencyKey String @unique

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, documentType, documentId])
  @@index([externalPaymentId])
  @@map("payment_intents")
}

// Global como Plan/SystemErrorLog - sin tenantId requerido ni RLS, a
// propósito: existe precisamente para deduplicar una notificación de MP
// ANTES de que se sepa (o se confíe en) qué tenant es, y la validación de
// firma en sí es estructuralmente previa a cualquier decisión de tenant
// (ver MercadoPagoWebhookController - nunca hay que poder distinguir "mal
// firmado" de "tenant inexistente" por la respuesta). tenantId queda
// nullable, recién se completa una vez identificado el `?client=` del
// query string, después de validar la firma.
//
// `processed` es la idempotencia real: un evento con processed=true nunca
// se reprocesa (ver "doble notificación = un solo asiento"). Uno con
// processed=false SÍ se reprocesa en el próximo reintento de MP a
// propósito - así un fallo real (recordReceipt tira, la transacción
// tenant-scoped hace rollback completo incluyendo el PaymentIntent que se
// había marcado PAID) deja una vía de recuperación real en vez de un
// cobro fantasma sin asiento.
model WebhookEvent {
  id       String            @id @default(uuid())
  provider ConnectorProvider

  tenantId String?

  externalId String // data.id (id del pago en MP)
  requestId  String? // x-request-id
  type       String // "payment", etc.

  signatureOk Boolean
  processed   Boolean @default(false)
  payload     Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, externalId, type])
  @@index([tenantId, processed])
  @@map("webhook_events")
}
