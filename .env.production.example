# .env del SERVIDOR de producción - copiar como .env al lado de
# docker-compose.prod.yml y completar. Nunca va al repo.
# Cada variable está explicada en .env.example; acá sólo lo que cambia en
# producción.
#
# Claves y contraseñas: generarlas con
#   openssl rand -hex 32
# (sólo letras y números, así no hay que escaparlas dentro de las URLs de
# conexión que arma docker-compose.prod.yml).

DOMAIN="oplex.com.ar"

# Imágenes que publica el deploy de GitHub Actions. IMAGE_TAG lo reescribe
# el propio deploy en cada publicación (el commit desplegado).
OPLEX_IMAGE_PREFIX="ghcr.io/dgb13/oplex"
IMAGE_TAG="latest"

# Base de datos. Las URLs de conexión las arma el compose con estas dos.
# APP_DB_PASSWORD se usa al crear la base por primera vez: cambiarla después
# pide también un ALTER ROLE plexo_app adentro de Postgres.
POSTGRES_PASSWORD=""
APP_DB_PASSWORD=""

JWT_SECRET=""
JWT_EXPIRES_IN="8h"
JWT_REMEMBER_ME_EXPIRES_IN="30d"

# OJO: es la llave de los certificados de ARCA y tokens cifrados de cada
# tenant. Guardar una copia fuera del servidor. Si se pierde, hay que volver
# a cargar todos los certificados. Si se migra la base desde otra máquina,
# tiene que ser LA MISMA que usaba esa máquina.
ENCRYPTION_MASTER_KEY=""

# Emails (Resend). Necesita el dominio verificado en Resend.
RESEND_API_KEY=""
EMAIL_FROM="Oplex <no-responder@oplex.com.ar>"

# También reciben los avisos por email de backups, disco y servidor.
PLATFORM_ADMIN_EMAILS=""
# Opcional: cómo se muestra el servidor en /admin/server.
SERVER_LOCATION="Vultr · Santiago de Chile"
SIGNUP_DEFAULT_PLAN_KEY="SILVER"
OTP_EXPIRY_MINUTES="15"
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES="60"
TEAM_INVITATION_EXPIRY_HOURS="72"
WHATSAPP_LINK_CODE_EXPIRY_MINUTES="10"

# FRONTEND_URL, OAUTH_CALLBACK_BASE_URL, MP_OAUTH_REDIRECT_URI,
# BACKUP_STORAGE_DIR y las URLs de la base las fija docker-compose.prod.yml a
# partir de DOMAIN: no hace falta ponerlas acá.
#
# URLs a registrar en cada proveedor:
#   Google:      https://oplex.com.ar/api/auth/oauth/google/callback
#   Microsoft:   https://oplex.com.ar/api/auth/oauth/microsoft/callback
#   Mercado Pago (redirect OAuth): https://oplex.com.ar/api/connectors/mercadopago/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_BUSINESS_DISPLAY_NUMBER=""

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# Sugerir categorías al importar artículos (por defecto claude-haiku-4-5).
ANTHROPIC_IMPORT_MODEL=""
ANTHROPIC_ASSISTANT_API_KEY=""
ANTHROPIC_ASSISTANT_MODEL=""
ANTHROPIC_ASSISTANT_HELP_MODEL=""

# Nunca en true en producción.
AFIP_PADRON_STUB="false"
