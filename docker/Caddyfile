# Un solo dominio: /api y /uploads van a la API, todo lo demás a la web.
# Así la web y la API comparten origen (sin CORS) y resolveUploadUrl() de la
# web arma bien las URLs de imágenes y adjuntos.
#
# Caddy saca y renueva solo el certificado HTTPS de Let's Encrypt.

{
	# Tiendas online (<subdominio>.oplex.com.ar): el certificado de cada
	# subdominio se saca recién con la primera visita, y sólo si la API
	# confirma que esa tienda existe (así nadie puede hacernos pedir
	# certificados para direcciones inventadas).
	on_demand_tls {
		ask http://api:3000/api/public/storefront/domain-check
	}
}

(oplex_routes) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /uploads/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:4200
	}
}

{$DOMAIN} {
	import oplex_routes
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Tiendas online. La web reconoce el subdominio y muestra esa tienda
# (apps/web/src/proxy.ts).
*.{$DOMAIN} {
	tls {
		on_demand
	}
	import oplex_routes
}
